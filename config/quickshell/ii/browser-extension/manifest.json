{
  "manifest_version": 3,
  "name": "Desktop AI quota link",
  "description": "Send only subscription usage to your local desktop panel. No cookie access.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "alarms", "storage"],
  "host_permissions": ["https://cursor.com/*", "https://zed.dev/*", "https://dashboard.zed.dev/*", "https://cloud.zed.dev/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_title": "Refresh desktop AI quotas"}
}
