{
  "id": "search",
  "title": "Search",
  "icon": "manage_search",
  "description": "The launcher (Super), its prefixes and web search.",
  "sections": [
    {
      "id": "launcher",
      "title": "Launcher",
      "icon": "apps",
      "description": "The search that opens when you press Super by itself: how it finds apps."
    },
    {
      "id": "prefixes",
      "title": "Prefixes",
      "icon": "keyboard_command_key",
      "description": "Type a prefix at the start of a search to switch what it looks for."
    },
    {
      "id": "web",
      "title": "Web search",
      "icon": "travel_explore",
      "description": "Where web searches go and which sites they leave out."
    }
  ],
  "entries": [
    {
      "key": "search.sloppy",
      "section": "launcher",
      "label": "Forgive typos",
      "description": "Finds apps despite typos, such as “fierfox” for Firefox, but abbreviations like “vsc” may stop working.",
      "keywords": [
        "levenshtein",
        "fuzzy",
        "errores",
        "Typo-tolerant matching",
        "Coincidencia tolerante a errores"
      ],
      "icon": "spellcheck",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "services/AppSearch.qml"
      ]
    },
    {
      "key": "search.nonAppResultDelay",
      "section": "launcher",
      "label": "Calculator delay",
      "description": "Wait after each key press before calculating, so typing stays smooth.",
      "keywords": [
        "Delay for other results",
        "Retraso de otros resultados"
      ],
      "icon": "timer",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "ms",
      "consumers": [
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "launcher.pinnedApps",
      "section": "launcher",
      "label": "Apps pinned in the start menu",
      "description": "Listed by .desktop file name without the extension, e.g. org.kde.dolphin, in the Windows-style start menu.",
      "help": "Only the alternative Windows-style panels use it; Ctrl+Super+P switches between panel styles.",
      "keywords": [
        "anclar",
        "fijar",
        "Pinned apps",
        "Aplicaciones ancladas"
      ],
      "icon": "push_pin",
      "backend": "config",
      "type": "list",
      "widget": "list",
      "validate": {
        "regex": "^[A-Za-z0-9._-]+$"
      },
      "consumers": [
        "services/LauncherApps.qml"
      ],
      "placeholder": "org.kde.dolphin"
    },
    {
      "key": "search.prefix.showDefaultActionsWithoutPrefix",
      "section": "prefixes",
      "label": "Add calculator, command and web results",
      "description": "Every search ends with a calculator result, a run-as-command result and a web search, even without a prefix.",
      "keywords": [
        "Show actions without a prefix",
        "Mostrar acciones sin prefijo"
      ],
      "icon": "bolt",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "search.prefix.app",
      "section": "prefixes",
      "label": "Apps",
      "description": "Search apps by name, e.g. >firefox.",
      "keywords": [
        "prefijo",
        "prefix"
      ],
      "icon": "apps",
      "backend": "config",
      "type": "string",
      "widget": "text",
      "validate": {
        "nonEmpty": true,
        "maxLength": 3,
        "regex": "^\\S+$",
        "unique": "searchPrefix"
      },
      "consumers": [
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "search.prefix.action",
      "section": "prefixes",
      "label": "Actions",
      "description": "Run a shell action such as /dark or /wallpaper; type the prefix alone to list them all.",
      "keywords": [
        "prefijo",
        "prefix"
      ],
      "icon": "bolt",
      "backend": "config",
      "type": "string",
      "widget": "text",
      "validate": {
        "nonEmpty": true,
        "maxLength": 3,
        "regex": "^\\S+$",
        "unique": "searchPrefix"
      },
      "consumers": [
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "search.prefix.clipboard",
      "section": "prefixes",
      "label": "Clipboard",
      "description": "Search the clipboard history; Super+V opens the launcher with this prefix.",
      "keywords": [
        "prefijo",
        "prefix"
      ],
      "icon": "content_paste",
      "backend": "config",
      "type": "string",
      "widget": "text",
      "validate": {
        "nonEmpty": true,
        "maxLength": 3,
        "regex": "^\\S+$",
        "unique": "searchPrefix"
      },
      "consumers": [
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "search.prefix.emojis",
      "section": "prefixes",
      "label": "Emojis",
      "description": "Search emojis to copy; Super+. opens the launcher with this prefix.",
      "keywords": [
        "prefijo",
        "prefix"
      ],
      "icon": "mood",
      "backend": "config",
      "type": "string",
      "widget": "text",
      "validate": {
        "nonEmpty": true,
        "maxLength": 3,
        "regex": "^\\S+$",
        "unique": "searchPrefix"
      },
      "consumers": [
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "search.prefix.math",
      "section": "prefixes",
      "label": "Calculator",
      "description": "Calculate with qalc, e.g. =2*(3+4); a search that starts with a number also calculates.",
      "keywords": [
        "prefijo",
        "prefix"
      ],
      "icon": "calculate",
      "backend": "config",
      "type": "string",
      "widget": "text",
      "validate": {
        "nonEmpty": true,
        "maxLength": 3,
        "regex": "^\\S+$",
        "unique": "searchPrefix"
      },
      "consumers": [
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "search.prefix.shellCommand",
      "section": "prefixes",
      "label": "Shell command",
      "description": "Run the typed text as a command in the background, without opening a terminal.",
      "keywords": [
        "prefijo",
        "prefix"
      ],
      "icon": "terminal",
      "backend": "config",
      "type": "string",
      "widget": "text",
      "validate": {
        "nonEmpty": true,
        "maxLength": 3,
        "regex": "^\\S+$",
        "unique": "searchPrefix"
      },
      "consumers": [
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "search.prefix.webSearch",
      "section": "prefixes",
      "label": "Web search",
      "description": "Search the web with the engine below.",
      "keywords": [
        "prefijo",
        "prefix"
      ],
      "icon": "travel_explore",
      "backend": "config",
      "type": "string",
      "widget": "text",
      "validate": {
        "nonEmpty": true,
        "maxLength": 3,
        "regex": "^\\S+$",
        "unique": "searchPrefix"
      },
      "consumers": [
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "search.engineBaseUrl",
      "section": "web",
      "label": "Search engine",
      "description": "Your search words are added at the end of this address.",
      "help": "Example: https://duckduckgo.com/?q= for DuckDuckGo.",
      "keywords": [
        "google",
        "duckduckgo",
        "motor"
      ],
      "icon": "link",
      "backend": "config",
      "type": "url",
      "widget": "text",
      "validate": {
        "regex": "^https?://\\S+$"
      },
      "consumers": [
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "search.excludedSites",
      "section": "web",
      "label": "Excluded sites",
      "description": "Each site is added as -site:<site> to web searches to leave its pages out, e.g. quora.com.",
      "help": "It only works with search engines that understand -site:, such as Google.",
      "icon": "block",
      "backend": "config",
      "type": "list",
      "widget": "list",
      "validate": {
        "regex": "^[A-Za-z0-9.-]+$"
      },
      "consumers": [
        "services/LauncherSearch.qml"
      ],
      "placeholder": "example.com"
    }
  ]
}
