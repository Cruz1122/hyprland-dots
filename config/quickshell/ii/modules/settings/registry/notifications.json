{
  "id": "notifications",
  "title": "Notifications",
  "icon": "notifications",
  "description": "Do Not Disturb, timeouts and where notifications appear.",
  "sections": [
    {
      "id": "behavior",
      "title": "Behavior",
      "icon": "notifications_active",
      "description": "Whether notifications pop up and how long they stay."
    },
    {
      "id": "placement",
      "title": "Placement",
      "icon": "monitor",
      "description": "Which monitor shows the notification pop-ups."
    },
    {
      "id": "conflicts",
      "title": "Other notification services",
      "icon": "block",
      "description": "Programs such as mako, dunst or KDE's kded6 can take over notifications or the tray."
    }
  ],
  "entries": [
    {
      "key": "ipc.notifications.silent",
      "section": "behavior",
      "label": "Do Not Disturb",
      "description": "New notifications go silently to the list in the right sidebar, without pop-ups.",
      "keywords": [
        "dnd",
        "silent",
        "silencio",
        "no molestar"
      ],
      "icon": "do_not_disturb_on",
      "backend": "ipc",
      "type": "bool",
      "widget": "switch"
    },
    {
      "key": "notifications.timeout",
      "section": "behavior",
      "label": "Popup duration",
      "description": "How long a popup stays when the app does not set its own timeout.",
      "keywords": [
        "timeout",
        "duración"
      ],
      "icon": "timer",
      "backend": "config",
      "type": "int",
      "widget": "slider",
      "min": 1000,
      "max": 30000,
      "step": 500,
      "uiScale": 0.001,
      "decimals": 1,
      "unit": " s",
      "consumers": [
        "services/Notifications.qml"
      ]
    },
    {
      "key": "notifications.monitor.enable",
      "section": "placement",
      "label": "Fixed monitor",
      "description": "Show popups on one monitor instead of the focused one.",
      "keywords": [
        "screen",
        "pantalla",
        "monitor"
      ],
      "icon": "monitor",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "modules/ii/notificationPopup/NotificationPopup.qml"
      ]
    },
    {
      "key": "notifications.monitor.name",
      "section": "placement",
      "label": "Monitor",
      "description": "Monitor that shows notification popups.",
      "icon": "desktop_windows",
      "backend": "config",
      "type": "custom",
      "widget": "custom",
      "keys": [
        "notifications.monitor.name"
      ],
      "enabledWhen": {
        "key": "notifications.monitor.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/notificationPopup/NotificationPopup.qml"
      ]
    },
    {
      "key": "conflictKiller.autoKillNotificationDaemons",
      "section": "conflicts",
      "label": "Close mako and dunst without asking",
      "description": "If the shell finds them running when it starts, it closes them instead of asking you.",
      "applies": "nextStart",
      "keywords": [
        "mako",
        "dunst",
        "kded",
        "Close other notification daemons",
        "Cerrar otros demonios de notificaciones"
      ],
      "icon": "notifications_off",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "services/ConflictKiller.qml",
        "killDialog.qml"
      ]
    },
    {
      "key": "conflictKiller.autoKillTrays",
      "section": "conflicts",
      "label": "Close KDE's tray service without asking",
      "description": "If the shell finds kded6 running when it starts, it closes it so tray icons show in the bar.",
      "applies": "nextStart",
      "keywords": [
        "tray",
        "bandeja",
        "Close other tray hosts",
        "Cerrar otras bandejas del sistema"
      ],
      "icon": "cancel",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "services/ConflictKiller.qml",
        "killDialog.qml"
      ]
    }
  ]
}
