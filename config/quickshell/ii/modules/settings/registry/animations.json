      ]
    },
    {
      "key": "appearance.animations.durationScale",
      "section": "shellMotion",
      "label": "Speed of menus and transitions",
      "description": "Changes how long switches, sliders and the transitions inside the shell's panels take.",
      "help": "It does not change how Hyprland opens windows or shell panels; that is the rest of this page. Loading spinners keep their speed, and some effects ignore it, such as button ripples, text fades, the scrollbar, the lock screen and the settings app's page transitions.",
      "keywords": [
        "Speed of the shell's motion",
        "animation speed",
        "shell animations",
        "velocidad",
        "velocidad de animaciones",
        "animaciones",
        "movimiento",
        "rapidez",
        "rápido",
        "lento",
        "transiciones",
        "duration",
        "duración"
      ],
      "icon": "speed",
      "backend": "config",
      "type": "enum",
      "widget": "segmented",
      "options": [
        {
          "value": 0.5,
          "label": "Very fast",
          "description": "Transitions take half the usual time."
        },
        {
          "value": 0.75,
          "label": "Fast",
          "description": "Transitions take three quarters of the usual time."
        },
        {
          "value": 1,
          "label": "Normal",
          "description": "The speed the shell was designed with."
        },
        {
          "value": 1.5,
          "label": "Slow",
          "description": "Transitions take one and a half times as long."
        },
        {
          "value": 2,
          "label": "Very slow",
          "description": "Transitions take twice as long, so it is easier to follow what moves."
        }
      ],
      "enabledWhen": {
        "key": "appearance.animations.reduceMotion",
        "notEquals": true
      },
      "consumers": [
        "modules/common/Appearance.qml"
      ]
    },
