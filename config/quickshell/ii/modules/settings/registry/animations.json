    {
      "key": "appearance.animations.reduceMotion",
      "section": "shellMotion",
      "label": "Reduce motion in the shell",
      "description": "Switches, sliders, menus and the transitions inside the shell's panels end instantly.",
      "help": "Some effects still animate, such as button ripples, text fades, the scrollbar, the lock screen and the settings app's page transitions; loading spinners keep turning and the speed below has no effect. For the desktop itself, turn off “Desktop animations” at the top of this page: the Minimal preset only shortens them.",
      "keywords": [
        "reduce motion",
        "reduced motion",
        "reducir movimiento",
        "menos movimiento",
        "sin animaciones",
        "quitar animaciones",
        "accesibilidad",
        "accessibility",
        "mareo",
        "motion sickness",
        "animaciones",
        "movimiento"
      ],
      "icon": "accessibility_new",
