{
  "id": "animations",
  "title": "Animations",
  "icon": "animation",
  "description": "How windows, workspaces and shell panels move, and the motion inside the shell.",
  "sections": [
    {
      "id": "intro",
      "title": "What each part controls",
      "icon": "info",
      "description": "Hyprland animates windows, workspaces and shell panels; the shell animates its own menus and controls."
    },
    {
      "id": "general",
      "title": "General",
      "icon": "tune",
      "description": "Turn every desktop animation on or off at once."
    },
    {
      "id": "windows",
      "title": "Windows",
      "icon": "select_window",
      "description": "How windows open, close and move, and whether resizing and dragging are animated."
    },
    {
      "id": "workspaces",
      "title": "Workspaces",
      "icon": "view_carousel",
      "description": "How you move between workspaces and how the auxiliary workspace (Super+S) appears."
    },
    {
      "id": "panels",
      "title": "Shell panels",
      "icon": "side_navigation",
      "description": "How long shell panels such as the sidebars take to open and close, and with which curve."
    },
    {
      "id": "details",
      "title": "Details",
      "icon": "more_horiz",
      "description": "The color change of the active window border and the screen zoom (Super + = / Super + -)."
    },
    {
      "id": "curves",
      "title": "My curves",
      "icon": "timeline",
      "description": "Curves you create here, ready to use in any animation on this page."
    },
    {
      "id": "shellMotion",
      "title": "Motion inside the shell",
      "icon": "motion_mode",
      "description": "Speed of the menus, buttons and panels drawn by the shell; it does not change Hyprland animations."
    }
  ],
