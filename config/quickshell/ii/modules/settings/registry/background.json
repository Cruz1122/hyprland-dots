{
  "id": "background",
  "title": "Wallpaper and widgets",
  "icon": "wallpaper",
  "description": "Wallpaper, its motion and the clock and weather widgets of the desktop.",
  "sections": [
    {
      "id": "wallpaper",
      "title": "Wallpaper",
      "icon": "wallpaper",
      "description": "Pick the wallpaper with Ctrl+Super+T; the theme colors follow it."
    },
    {
      "id": "parallax",
      "title": "Wallpaper motion",
      "icon": "3d_rotation",
      "description": "The wallpaper slides a little as you switch workspaces or open a sidebar (parallax)."
    },
    {
      "id": "clock",
      "title": "Clock",
      "icon": "schedule",
      "description": "Drag the clock on the desktop to move it."
    },
    {
      "id": "cookieClock",
      "title": "Analog clock",
      "icon": "cookie",
      "description": "Shape, hands and date of the analog clock with a wavy edge."
    },
    {
      "id": "digitalClock",
      "title": "Digital clock",
      "icon": "timer_10_select",
      "description": "Layout, font and animation of the digital clock."
    },
    {
      "id": "quote",
      "title": "Quote",
      "icon": "format_quote",
      "description": "Text of your choice under the clock, in either clock style."
    },
    {
      "id": "weather",
      "title": "Weather widget",
      "icon": "partly_cloudy_day",
      "description": "Its location and units are set in Services."
    }
  ],
  "entries": [
    {
      "key": "info.background.wallpaper",
      "section": "wallpaper",
      "label": "Current wallpaper",
      "description": "Choosing a wallpaper also regenerates the colors.",
      "keywords": [
        "wallpaper",
        "fondo",
        "imagen",
        "konachan",
        "osu"
      ],
      "icon": "image",
      "backend": "readonly",
      "type": "custom",
      "widget": "custom"
    },
    {
      "key": "wallpaperSelector.useSystemFileDialog",
      "section": "wallpaper",
      "label": "Use the system file dialog",
      "description": "Ctrl+Super+T opens the system file dialog instead of the shell's wallpaper picker.",
      "icon": "folder_open",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/wallpaperSelector/WallpaperSelector.qml",
        "modules/ii/wallpaperSelector/WallpaperSelectorContent.qml"
      ]
    },
    {
      "key": "background.hideWhenFullscreen",
      "section": "wallpaper",
      "label": "Hide under fullscreen windows",
      "description": "Stop drawing the wallpaper while a fullscreen window covers it.",
      "icon": "fullscreen",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/background/Background.qml"
      ]
    },
    {
      "key": "policies.weeb",
      "section": "wallpaper",
      "label": "Anime content",
      "description": "Random anime wallpaper buttons on this page and in the welcome app, and a Homework folder in the wallpaper picker.",
      "keywords": [
        "weeb",
        "anime",
        "konachan",
        "osu"
      ],
      "icon": "favorite",
      "backend": "config",
      "type": "enum",
      "widget": "segmented",
      "options": [
        {
          "value": 0,
          "label": "Off",
          "description": "No anime wallpaper buttons and no Homework folder."
        },
        {
          "value": 1,
          "label": "On",
          "description": "Random wallpaper buttons here and in the welcome app, plus the Homework folder."
        },
        {
          "value": 2,
          "label": "Discreet",
          "description": "Hides them too; the left sidebar button stays in the bar."
        }
      ],
      "consumers": [
        "modules/ii/bar/LeftSidebarButton.qml",
        "modules/ii/wallpaperSelector/WallpaperSelectorContent.qml",
        "welcome.qml"
      ]
    },
    {
      "key": "background.parallax.enableWorkspace",
      "section": "parallax",
      "label": "Follow workspaces",
      "description": "Slide the wallpaper a step each time you switch workspace.",
      "keywords": [
        "parallax",
        "paralaje",
        "Parallax",
        "Desplazamiento"
      ],
      "icon": "view_carousel",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/background/Background.qml"
      ]
    },
    {
      "key": "background.parallax.enableSidebar",
      "section": "parallax",
      "label": "Follow sidebars",
      "description": "Slide the wallpaper a little to one side when a sidebar opens.",
      "keywords": [
        "parallax",
        "paralaje",
        "Parallax",
        "Desplazamiento"
      ],
      "icon": "dock_to_left",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/background/Background.qml"
      ]
    },
    {
      "key": "background.parallax.vertical",
      "section": "parallax",
      "label": "Vertical movement",
      "description": "Move the wallpaper up and down instead of sideways.",
      "icon": "swap_vert",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/background/Background.qml"
      ],
      "keywords": [
        "Parallax",
        "Desplazamiento"
      ]
    },
    {
      "key": "background.parallax.autoVertical",
      "section": "parallax",
      "label": "Vertical for portrait images",
      "description": "Use vertical movement when the wallpaper is taller than wide.",
      "icon": "crop_portrait",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "background.parallax.vertical",
        "equals": false
      },
      "consumers": [
        "modules/ii/background/Background.qml"
      ],
      "keywords": [
        "Parallax",
        "Desplazamiento"
      ]
    },
    {
      "key": "background.parallax.workspaceZoom",
      "section": "parallax",
      "label": "Wallpaper zoom for motion",
      "description": "Enlarges the wallpaper so it can slide; more zoom gives more motion but crops more of the image.",
      "help": "At 100 % the wallpaper only moves if it is wider (or taller) than the screen.",
      "keywords": [
        "Wallpaper zoom",
        "Zoom del fondo",
        "parallax",
        "Parallax",
        "Desplazamiento"
      ],
      "icon": "zoom_in",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 1,
      "max": 2,
      "step": 0.01,
      "uiScale": 100,
      "decimals": 0,
      "unit": "%",
      "consumers": [
        "modules/ii/background/Background.qml"
      ]
    },
    {
      "key": "background.parallax.widgetsFactor",
      "section": "parallax",
      "label": "Widget movement",
      "description": "How far the clock and weather widgets move compared with the wallpaper; 0 keeps them still.",
      "icon": "widgets",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "decimals": 1,
      "unit": "×",
      "consumers": [
        "modules/ii/background/Background.qml"
      ],
      "keywords": [
        "Parallax",
        "Desplazamiento"
      ]
    },
    {
      "key": "background.widgets.deskPoster.enable",
      "section": "clock",
