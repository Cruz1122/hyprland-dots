{
  "id": "background",
  "title": "Wallpaper and widgets",
  "icon": "wallpaper",
  "description": "Wallpaper, parallax and desktop widgets.",
  "sections": [
    {
      "id": "wallpaper",
      "title": "Wallpaper",
      "icon": "wallpaper"
    },
    {
      "id": "parallax",
      "title": "Parallax",
      "icon": "3d_rotation",
      "description": "Move the wallpaper as you switch workspaces or open sidebars."
    },
    {
      "id": "clock",
      "title": "Clock",
      "icon": "schedule",
      "description": "Drag the clock on the desktop to move it."
    },
    {
      "id": "cookieClock",
      "title": "Cookie clock",
      "icon": "cookie"
    },
    {
      "id": "digitalClock",
      "title": "Digital clock",
      "icon": "timer_10_select"
    },
    {
      "id": "quote",
      "title": "Quote",
      "icon": "format_quote"
    },
    {
      "id": "weather",
      "title": "Weather widget",
      "icon": "partly_cloudy_day"
    }
  ],
  "entries": [
    {
      "key": "info.background.wallpaper",
      "section": "wallpaper",
      "label": "Current wallpaper",
      "description": "Choosing a wallpaper also regenerates the colors.",
      "keywords": [
        "wallpaper",
        "fondo",
        "imagen",
        "konachan",
        "osu"
      ],
      "icon": "image",
      "backend": "readonly",
      "type": "custom",
      "widget": "custom"
    },
    {
      "key": "wallpaperSelector.useSystemFileDialog",
      "section": "wallpaper",
      "label": "Use the system file dialog",
      "description": "Pick wallpapers with the system dialog instead of the shell's wallpaper picker.",
      "icon": "folder_open",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/wallpaperSelector/WallpaperSelector.qml",
        "modules/ii/wallpaperSelector/WallpaperSelectorContent.qml"
      ]
    },
    {
      "key": "background.hideWhenFullscreen",
      "section": "wallpaper",
      "label": "Hide under fullscreen windows",
      "description": "Stop drawing the wallpaper while a fullscreen window covers it.",
      "icon": "fullscreen",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/background/Background.qml"
      ]
    },
    {
      "key": "policies.weeb",
      "section": "wallpaper",
      "label": "Anime content",
      "description": "Random anime wallpapers and anime extras in the left sidebar; Discreet keeps only the sidebar extras.",
      "keywords": [
        "weeb",
        "anime",
        "konachan",
        "osu"
      ],
      "icon": "favorite",
      "backend": "config",
      "type": "enum",
      "widget": "segmented",
      "options": [
        {
          "value": 0,
          "label": "Off"
        },
        {
          "value": 1,
          "label": "On"
        },
        {
          "value": 2,
          "label": "Discreet"
        }
      ],
      "consumers": [
        "modules/ii/bar/LeftSidebarButton.qml",
        "modules/ii/wallpaperSelector/WallpaperSelectorContent.qml",
        "welcome.qml"
      ]
    },
    {
      "key": "background.parallax.enableWorkspace",
      "section": "parallax",
      "label": "Follow workspaces",
      "description": "Shift the wallpaper when switching workspaces.",
      "icon": "view_carousel",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/background/Background.qml"
      ]
    },
    {
      "key": "background.parallax.enableSidebar",
      "section": "parallax",
      "label": "Follow sidebars",
