      "icon": "swap_vert",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/background/Background.qml"
      ]
    },
    {
      "key": "background.parallax.autoVertical",
      "section": "parallax",
      "label": "Vertical for portrait images",
      "description": "Use vertical movement when the wallpaper is taller than wide.",
      "icon": "crop_portrait",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "background.parallax.vertical",
        "equals": false
      },
      "consumers": [
        "modules/ii/background/Background.qml"
      ]
    },
    {
      "key": "background.parallax.workspaceZoom",
      "section": "parallax",
      "label": "Wallpaper zoom",
      "description": "Enlarge the wallpaper to leave room for the movement.",
      "icon": "zoom_in",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 1,
      "max": 2,
      "step": 0.01,
      "uiScale": 100,
      "decimals": 0,
      "unit": "%",
      "consumers": [
        "modules/ii/background/Background.qml"
      ]
    },
    {
      "key": "background.parallax.widgetsFactor",
      "section": "parallax",
      "label": "Widget movement",
      "description": "How far desktop widgets move compared with the wallpaper.",
      "icon": "widgets",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "decimals": 1,
      "unit": "×",
      "consumers": [
        "modules/ii/background/Background.qml"
      ]
    },
    {
      "key": "background.widgets.clock.enable",
