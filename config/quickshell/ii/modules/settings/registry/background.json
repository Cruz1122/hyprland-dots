      "key": "background.widgets.clock.showOnlyWhenLocked",
      "section": "clock",
      "label": "Only on the lock screen",
      "description": "Hide the clock while the session is unlocked.",
      "icon": "lock",
      "backend": "config",
      "type": "bool",
