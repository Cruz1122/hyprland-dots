        {
          "value": "leastBusy",
          "label": "Emptiest area",
          "description": "Moves to the plainest part of the wallpaper each time it changes."
        },
        {
          "value": "mostBusy",
          "label": "Busiest area",
          "description": "Moves to the most detailed part of the wallpaper each time it changes."
