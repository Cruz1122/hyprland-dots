      "icon": "padding"
    },
    {
      "id": "blur",
      "title": "Blur",
      "icon": "blur_on"
    },
    {
      "id": "shadows",
      "title": "Shadows",
      "icon": "shadow"
    },
    {
      "id": "dimming",
      "title": "Dimming",
      "icon": "brightness_medium"
    },
    {
      "id": "opacity",
      "title": "Opacity",
      "icon": "opacity"
    },
    {
      "id": "behavior",
      "title": "Behavior",
      "icon": "tune"
    },
    {
      "id": "gestures",
      "title": "Gestures",
