{
  "id": "capture",
  "title": "Capture and recording",
  "icon": "screen_record",
  "description": "Screenshots, the area selector and screen recording.",
  "sections": [
    {
      "id": "screenshots",
      "title": "Screenshots",
      "icon": "screenshot_region",
      "description": "Area screenshots taken with Super+Shift+S: where they are saved and which editor opens them."
    },
    {
      "id": "imageSearch",
      "title": "Image search",
      "icon": "image_search",
      "description": "Search the web with a part of the screen, like Google Lens (Super+Shift+A)."
    },
    {
      "id": "regionSelector",
      "title": "Area selector",
      "icon": "select",
      "description": "Appears when you capture, search or record an area: click a window or drag a rectangle."
    },
    {
      "id": "recordingActions",
      "title": "Recording controls",
      "icon": "radio_button_checked",
      "description": "Start, pause and stop screen recordings; Ctrl+Alt+R also records the whole screen."
    },
    {
      "id": "recording",
      "title": "Screen recording",
      "icon": "videocam",
      "description": "Where recordings are saved, their quality and their sound."
    }
  ],
  "entries": [
    {
      "key": "screenSnip.savePath",
      "section": "screenshots",
      "label": "Screenshot folder",
      "description": "Area screenshots are also saved here as PNG; leave it empty to only copy them to the clipboard.",
      "icon": "folder",
      "keywords": [
        "captura",
        "carpeta",
        "screenshot"
      ],
      "backend": "config",
      "type": "path",
      "widget": "path",
      "consumers": [
        "modules/ii/regionSelector/RegionSelection.qml"
      ],
      "placeholder": "Clipboard only",
      "pick": "folder"
    },
    {
      "key": "regionSelector.annotation.useSatty",
      "section": "screenshots",
      "label": "Annotate with Satty",
      "description": "Open screenshots for editing in Satty instead of Swappy.",
      "help": "Right-click the area in the selector to open it in the editor instead of copying it.",
      "icon": "draw",
      "keywords": [
        "swappy",
        "editar",
        "anotar"
      ],
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "enabledWhen": {
        "capability": "satty"
      },
      "consumers": [
        "modules/common/utils/ScreenshotAction.qml"
      ]
    },
    {
      "key": "search.imageSearch.imageSearchEngineBaseUrl",
      "section": "imageSearch",
      "label": "Image search engine",
      "description": "The selected area is uploaded and its link is added at the end of this address.",
      "help": "The image goes to uguu.se, a public file host, so avoid searching private content. Example: https://lens.google.com/uploadbyurl?url=",
      "icon": "travel_explore",
      "keywords": [
        "lens",
        "google",
        "buscar imagen"
      ],
      "backend": "config",
      "type": "url",
      "widget": "text",
      "validate": {
        "regex": "^https?://\\S+$"
      },
      "consumers": [
        "modules/common/utils/ScreenshotAction.qml"
      ]
    },
    {
      "key": "search.imageSearch.useCircleSelection",
      "section": "imageSearch",
      "label": "Circle to search",
      "description": "Select the area to search by drawing around it instead of a rectangle.",
      "help": "Windows and panels cannot be picked with a click in this mode.",
      "icon": "gesture",
      "keywords": [
        "círculo",
        "circle"
      ],
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "modules/ii/regionSelector/RegionSelector.qml"
      ]
    },
    {
      "key": "regionSelector.targetRegions.windows",
      "section": "regionSelector",
      "label": "Pick windows with a click",
      "description": "Outlines every open window, so a click captures the whole window.",
      "help": "Not available with circle selection.",
      "keywords": [
        "Snap to windows",
        "Ajustar a ventanas",
        "Region selector",
        "Selector de región"
      ],
      "icon": "select_window",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "modules/ii/regionSelector/RegionSelection.qml"
      ]
    },
    {
      "key": "regionSelector.targetRegions.layers",
      "section": "regionSelector",
      "label": "Pick panels with a click",
      "description": "Also outlines open shell panels such as the sidebars, so a click captures one; the bar and dock are not included.",
      "help": "Not available with circle selection.",
      "keywords": [
        "Snap to shell layers",
        "Ajustar a capas del shell",
        "layers",
        "capas"
      ],
      "icon": "layers",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "modules/ii/regionSelector/RegionSelection.qml"
      ]
    },
    {
      "key": "regionSelector.targetRegions.content",
      "section": "regionSelector",
      "label": "Pick images and text with a click",
      "description": "Detects images and blocks of text on the screen and outlines them as ready-made areas.",
      "help": "The detection analyzes the screen each time the selector opens and can miss or merge areas.",
      "keywords": [
        "Snap to content",
        "Ajustar al contenido"
      ],
      "icon": "image",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "modules/ii/regionSelector/RegionSelection.qml"
      ]
    },
    {
      "key": "regionSelector.targetRegions.showLabel",
      "section": "regionSelector",
      "label": "Show region labels",
      "description": "Writes the app name on each outlined window and the panel name on each panel.",
      "keywords": [
        "Mostrar etiquetas de región"
      ],
      "icon": "label",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "modules/ii/regionSelector/TargetRegion.qml"
      ]
    },
    {
      "key": "regionSelector.targetRegions.opacity",
      "section": "regionSelector",
      "label": "Region highlight opacity",
      "description": "How visible the outlines of windows and panels are while you choose.",
      "keywords": [
        "Opacidad del resaltado de regiones"
      ],
      "icon": "opacity",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "unit": "%",
      "uiScale": 100,
      "consumers": [
        "modules/ii/regionSelector/RegionSelection.qml"
      ]
    },
    {
      "key": "regionSelector.targetRegions.contentRegionOpacity",
      "section": "regionSelector",
      "label": "Content highlight opacity",
      "description": "How visible the outlines of detected images and text are.",
      "keywords": [
        "Opacidad del resaltado de contenido"
      ],
      "icon": "opacity",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "unit": "%",
      "uiScale": 100,
      "consumers": [
        "modules/ii/regionSelector/RegionSelection.qml"
      ]
    },
    {
      "key": "regionSelector.targetRegions.selectionPadding",
      "section": "regionSelector",
      "label": "Margin around a clicked area",
      "description": "Space added on every side of a window, panel or detected area picked with a click.",
      "keywords": [
        "Region padding",
        "Margen de región"
      ],
      "icon": "padding",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 0,
      "max": 50,
      "unit": "px",
      "consumers": [
        "modules/ii/regionSelector/RegionSelection.qml"
      ]
    },
    {
      "key": "regionSelector.rect.showAimLines",
      "section": "regionSelector",
      "label": "Show aim lines",
      "description": "Faint lines across the whole screen follow the pointer while you draw a rectangle.",
      "keywords": [
        "Aim lines",
        "Líneas de mira",
        "crosshair"
      ],
      "icon": "center_focus_weak",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "modules/ii/regionSelector/RectCornersSelectionDetails.qml"
      ]
    },
    {
      "key": "regionSelector.circle.strokeWidth",
      "section": "regionSelector",
      "label": "Circle stroke width",
      "description": "Thickness of the line drawn in circle selection.",
      "icon": "line_weight",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 1,
      "max": 20,
      "unit": "px",
      "consumers": [
        "modules/ii/regionSelector/CircleSelectionDetails.qml"
      ]
    },
    {
      "key": "regionSelector.circle.padding",
      "section": "regionSelector",
      "label": "Circle padding",
      "description": "Extra space added around a circled area.",
      "icon": "padding",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 0,
      "max": 50,
      "unit": "px",
      "consumers": [
        "modules/ii/regionSelector/RegionSelection.qml"
      ]
    },
    {
      "key": "action.capture.recordScreen",
      "section": "recordingActions",
      "label": "Record the screen",
      "description": "Start recording the whole screen, or stop the current recording.",
      "icon": "screen_record",
      "backend": "action",
      "type": "action",
      "action": "recordScreen",
      "actionLabel": "Record",
      "actionIcon": "screen_record"
    },
    {
      "key": "action.capture.recordRegion",
      "section": "recordingActions",
      "label": "Record a region",
      "description": "Pick an area with the selector and record it, like Super+Shift+R.",
      "keywords": [
        "Grabar una región"
      ],
      "icon": "screenshot_region",
      "backend": "action",
      "type": "action",
      "enabledWhen": {
        "capability": "ipc:regionRecord"
      },
      "action": "recordRegion",
      "actionLabel": "Select",
      "actionIcon": "screenshot_region"
    },
    {
      "key": "action.capture.pauseRecording",
      "section": "recordingActions",
      "label": "Pause or resume",
      "description": "Pause the current recording, or resume it.",
      "icon": "pause",
      "backend": "action",
      "type": "action",
      "action": "pauseRecording",
      "actionLabel": "Pause or resume",
      "actionIcon": "pause"
    },
    {
      "key": "action.capture.stopRecording",
      "section": "recordingActions",
      "label": "Stop recording",
      "description": "Stop the current recording and save the file.",
      "icon": "stop_circle",
      "backend": "action",
      "type": "action",
      "action": "stopRecording",
      "actionLabel": "Stop",
      "actionIcon": "stop_circle",
      "actionKind": "danger"
    },
    {
      "key": "screenRecord.barButtonAction",
      "section": "recordingActions",
      "label": "Left sidebar record button",
      "description": "What the record button of the left sidebar (Super+A) does when clicked.",
      "icon": "radio_button_checked",
      "keywords": [
        "record",
        "grabar",
        "grabación",
        "sidebar",
        "barra lateral"
      ],
      "backend": "config",
      "type": "enum",
      "widget": "select",
      "options": [
        {
          "value": "fullscreen",
          "label": "Record the full screen",
          "icon": "fullscreen"
        },
        {
          "value": "region",
          "label": "Record a region",
          "icon": "crop_free"
        },
        {
          "value": "pause",
          "label": "Pause or resume",
          "icon": "pause"
        },
        {
          "value": "stop",
          "label": "Stop recording",
          "icon": "stop"
        }
      ],
      "consumers": [
        "modules/ii/sidebarLeft/SidebarLeftContent.qml"
      ]
    },
    {
      "key": "screenRecord.savePath",
      "section": "recording",
      "label": "Video folder",
      "description": "Recordings are saved here as recording_<date>.<format>.",
      "icon": "folder",
      "backend": "config",
      "type": "path",
      "widget": "path",
      "validate": {
        "nonEmpty": true
      },
      "consumers": [
        "config/quickshell/ii/scripts/videos/record.sh"
      ],
      "pick": "folder"
    },
    {
      "key": "screenRecord.fileFormat",
      "section": "recording",
      "label": "File format",
      "description": "Type of video file each recording is saved as.",
      "icon": "movie",
      "backend": "config",
      "type": "enum",
      "widget": "segmented",
      "options": [
        {
          "value": "mp4",
          "label": "MP4",
          "description": "Plays almost everywhere."
        },
        {
          "value": "mkv",
          "label": "MKV",
          "description": "Still playable if a crash cuts the recording short."
        },
        {
          "value": "webm",
          "label": "WebM",
          "description": "Open format made for the web."
        }
      ],
      "consumers": [
        "config/quickshell/ii/scripts/videos/record.sh"
      ]
    },
    {
      "key": "screenRecord.fps",
      "section": "recording",
      "label": "Frame rate",
      "description": "Higher is smoother but makes larger files.",
      "icon": "speed",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 1,
      "max": 240,
      "unit": "fps",
      "consumers": [
        "config/quickshell/ii/scripts/videos/record.sh"
      ]
    },
    {
      "key": "screenRecord.pixelFormat",
      "section": "recording",
      "label": "Color format",
      "description": "How colors are stored in the video; keep yuv420p unless you need another one.",
      "keywords": [
        "Pixel format",
        "Formato de píxel",
        "yuv420p",
        "nv12"
      ],
      "icon": "palette",
      "backend": "config",
      "type": "enum",
      "widget": "select",
      "options": [
        {
          "value": "yuv420p",
          "label": "yuv420p (most compatible)",
          "description": "Plays in every video player and browser."
        },
        {
          "value": "nv12",
          "label": "nv12",
          "description": "Same color detail as yuv420p in another layout; some hardware encoders need it."
        },
        {
          "value": "auto",
          "label": "Automatic",
          "description": "wf-recorder picks the format."
        }
      ],
      "consumers": [
        "config/quickshell/ii/scripts/videos/record.sh"
      ]
    },
    {
      "key": "screenRecord.fullscreenUsesFocusedMonitor",
      "section": "recording",
      "label": "Record the focused monitor",
      "description": "With several monitors, full-screen recordings capture only the one that has focus.",
      "keywords": [
        "Grabar el monitor enfocado"
      ],
      "icon": "select_window",
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "config/quickshell/ii/scripts/videos/record.sh"
      ]
    },
    {
      "key": "screenRecord.recordAudioByDefault",
      "section": "recording",
      "label": "Record audio by default",
      "description": "Recordings started without choosing sound, such as Ctrl+Alt+R or the buttons above, include audio.",
      "help": "Super+Shift+Alt+R always records the system sound.",
      "icon": "mic",
      "keywords": [
        "sonido",
        "audio",
        "Grabar audio por defecto"
      ],
      "backend": "config",
      "type": "bool",
      "widget": "switch",
      "consumers": [
        "modules/common/utils/ScreenshotAction.qml",
        "config/quickshell/ii/scripts/videos/record.sh"
      ]
    },
    {
      "key": "screenRecord.audioSource",
      "section": "recording",
      "label": "Audio source",
      "description": "What is recorded when audio is included.",
      "icon": "graphic_eq",
      "backend": "config",
      "type": "enum",
      "widget": "segmented",
      "options": [
        {
          "value": "system",
          "label": "System",
          "icon": "speaker",
          "description": "What your speakers or headphones play."
        },
        {
          "value": "mic",
          "label": "Microphone",
          "icon": "mic"
        },
        {
          "value": "both",
          "label": "Both",
          "icon": "join",
          "description": "System sound and microphone mixed in one track."
        },
        {
          "value": "none",
          "label": "None",
          "icon": "volume_off",
          "description": "No audio, unless a shortcut asks for sound, such as Super+Shift+Alt+R."
        }
      ],
      "consumers": [
        "modules/common/utils/ScreenshotAction.qml",
        "config/quickshell/ii/scripts/videos/record.sh"
      ]
    },
    {
      "key": "screenRecord.systemAudioDevice",
      "section": "recording",
      "label": "System audio device",
      "description": "Output whose sound is recorded; Default follows the current output.",
      "icon": "speaker",
      "backend": "config",
      "type": "custom",
      "widget": "custom",
      "visibleWhen": {
        "key": "screenRecord.audioSource",
        "in": [
          "system",
          "both"
        ]
      },
      "consumers": [
        "config/quickshell/ii/scripts/videos/record.sh"
      ],
      "keys": [
        "screenRecord.systemAudioDevice"
      ]
    },
    {
      "key": "screenRecord.micDevice",
      "section": "recording",
      "label": "Microphone device",
      "description": "Microphone that is recorded; Default follows the current input.",
      "icon": "mic",
      "backend": "config",
      "type": "custom",
      "widget": "custom",
      "visibleWhen": {
        "key": "screenRecord.audioSource",
        "in": [
          "mic",
          "both"
        ]
      },
      "consumers": [
        "config/quickshell/ii/scripts/videos/record.sh"
      ],
      "keys": [
        "screenRecord.micDevice"
      ]
    }
  ]
}
