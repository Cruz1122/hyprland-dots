    {
      "key": "apps.terminal",
      "section": "commands",
      "label": "Terminal command",
      "description": "Opens launcher apps that run in a terminal, such as htop, e.g. kitty -1.",
      "help": "Super+Enter uses its own terminal, listed under Apps opened by shortcuts.",
      "keywords": [
        "Terminal",
        "kitty"
      ],
      "icon": "terminal",
      "backend": "config",
      "type": "string",
      "widget": "text",
      "validate": {
        "nonEmpty": true,
        "maxLength": 500
      },
      "consumers": [
        "modules/waffle/bar/StartButton.qml",
        "services/LauncherSearch.qml"
      ]
    },
    {
      "key": "apps.taskManager",
      "section": "commands",
      "label": "Task manager",
      "description": "Opened by the Task Manager button of the session menu (Ctrl+Alt+Delete), e.g. plasma-systemmonitor.",
      "icon": "monitoring",
      "backend": "config",
      "type": "string",
      "widget": "text",
      "validate": {
        "nonEmpty": true,
        "maxLength": 500
      },
      "consumers": [
        "modules/common/functions/Session.qml",
        "modules/waffle/bar/StartButton.qml"
      ]
    },
    {
      "key": "apps.volumeMixer",
      "section": "commands",
