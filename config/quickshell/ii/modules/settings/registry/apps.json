{
  "id": "apps",
  "title": "Applications",
  "icon": "apps",
  "description": "Default applications and the commands the shell launches.",
  "sections": [
    {
      "id": "defaults",
      "title": "Default applications",
      "icon": "open_in_new",
      "description": "Applications that open links and files of each kind."
    },
    {
      "id": "commands",
      "title": "Shell commands",
      "icon": "terminal",
      "description": "Command lines the shell runs from its buttons and menus, such as kitty -1 for a terminal."
    },
    {
      "id": "hyprland",
      "title": "Apps opened by shortcuts",
      "icon": "code",
      "description": "Read-only, from variables.lua: when a shortcut lists several apps, the first one installed opens. Edit ~/.config/hypr/custom/variables.lua to change them."
    }
  ],
  "entries": [
    {
      "key": "mime.browser",
      "section": "defaults",
      "label": "Web browser",
      "description": "Opens web links (http and https) and HTML files.",
      "keywords": [
        "navegador",
        "http"
      ],
      "icon": "public",
      "backend": "mime",
      "type": "string",
      "widget": "device"
    },
    {
      "key": "mime.fileManager",
      "section": "defaults",
      "label": "File manager",
      "description": "Opens folders when another app asks to show one.",
