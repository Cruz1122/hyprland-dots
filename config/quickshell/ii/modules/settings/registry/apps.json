{
  "id": "apps",
  "title": "Applications",
  "icon": "apps",
  "description": "Default applications and the commands the shell launches.",
  "sections": [
    {
      "id": "defaults",
      "title": "Default applications",
      "icon": "open_in_new",
      "description": "Applications that open links and files of each kind."
    },
    {
      "id": "commands",
      "title": "Shell commands",
      "icon": "terminal",
      "description": "Commands the shell runs from its buttons and menus."
    },
    {
      "id": "hyprland",
      "title": "Hyprland variables",
      "icon": "code",
      "description": "Apps launched by keybinds, read from variables.lua; edit ~/.config/hypr/custom/variables.lua to change them."
    }
  ],
  "entries": [
    {
      "key": "mime.browser",
      "section": "defaults",
      "label": "Web browser",
      "description": "Opens links and web pages.",
      "keywords": [
        "navegador",
        "http"
      ],
      "icon": "public",
      "backend": "mime",
      "type": "string",
      "widget": "device"
    },
