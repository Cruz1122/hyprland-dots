{
  "id": "bar",
  "title": "Bar",
  "icon": "toast",
  "iconRotation": 180,
  "description": "Position, layout, modules and tray of the bar.",
  "sections": [
    {
      "id": "layout",
      "title": "Layout",
      "icon": "dashboard",
      "description": "Where the bar sits and how it looks; Super+J shows or hides it."
    },
    {
      "id": "autoHide",
      "title": "Auto-hide",
      "icon": "visibility_off",
      "description": "Hide the bar until the pointer reaches its edge, to gain screen space."
    },
    {
      "id": "workspaces",
      "title": "Workspaces",
      "icon": "workspaces",
      "description": "The workspace indicator of the bar; right-click it to open the overview."
    },
    {
      "id": "buttons",
      "title": "Buttons",
      "icon": "smart_button",
      "description": "Buttons next to the clock, shown with “Show song title and buttons” on screens over 1200 px wide."
    },
    {
      "id": "indicators",
      "title": "Indicators and tooltips",
      "icon": "notifications",
      "description": "Badges and the details that bar modules open on hover or click."
    },
    {
      "id": "resources",
      "title": "Resources",
      "icon": "memory",
      "description": "Usage meters of the vertical bar, shown only when the bar is on a side."
    },
    {
      "id": "weather",
      "title": "Weather",
      "icon": "partly_cloudy_day",
      "description": "Weather module of the horizontal bar; the location and units are set in Services."
    },
    {
      "id": "tray",
      "title": "System tray",
      "icon": "shelf_auto_hide",
      "description": "Icons of apps running in the background, such as Steam or an input method."
    }
  ],
  "entries": [
    {
      "key": "bar.position",
      "section": "layout",
      "label": "Position",
      "description": "Screen edge the bar sits on.",
      "keywords": [
        "top",
        "bottom",
        "vertical",
        "arriba",
        "abajo",
        "izquierda",
        "derecha"
      ],
      "icon": "toast",
      "backend": "config",
      "type": "custom",
      "widget": "custom",
      "keys": [
        "bar.bottom",
        "bar.vertical"
      ],
      "consumers": [
        "modules/ii/bar/AiQuotaPopup.qml",
        "modules/ii/bar/Bar.qml",
        "modules/ii/bar/BarContent.qml",
        "modules/ii/bar/StyledPopup.qml",
        "modules/ii/bar/SysTrayItem.qml",
        "modules/ii/bar/SysTrayMenu.qml",
        "modules/ii/mediaControls/MediaControls.qml"
      ]
    },
    {
      "key": "bar.cornerStyle",
      "section": "layout",
      "label": "Bar shape",
      "description": "How the bar meets the edges and corners of the screen.",
      "keywords": [
        "Style",
        "Estilo"
      ],
      "icon": "rounded_corner",
      "backend": "config",
      "type": "enum",
      "widget": "segmented",
      "options": [
        {
          "value": 0,
          "label": "Hug",
          "description": "Spans the edge and curves into the rounded screen corners."
        },
        {
          "value": 1,
          "label": "Float",
          "description": "Floats with a gap and rounded corners."
        },
        {
          "value": 2,
          "label": "Rectangle",
          "description": "Spans the edge with square corners."
        }
      ],
      "consumers": [
        "modules/common/Appearance.qml",
        "modules/ii/bar/Bar.qml",
        "modules/ii/bar/BarContent.qml",
        "modules/ii/verticalBar/VerticalBar.qml"
      ]
    },
    {
      "key": "bar.floatStyleShadow",
      "section": "layout",
      "label": "Shadow under the bar",
      "description": "Add a soft shadow below the floating bar so it stands out from windows.",
      "keywords": [
        "Floating shadow",
        "Sombra flotante"
      ],
      "icon": "shadow",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "bar.cornerStyle",
        "equals": 1
      },
      "consumers": [
        "modules/ii/bar/BarContent.qml"
      ]
    },
    {
      "key": "bar.borderless",
      "section": "layout",
      "label": "Module grouping",
      "description": "How the bar separates its groups of modules.",
      "keywords": [
        "Grouping",
        "Agrupación"
      ],
      "icon": "view_column",
      "backend": "config",
      "type": "enum",
      "widget": "segmented",
      "options": [
        {
          "value": false,
          "label": "Pills",
          "description": "Each group sits on its own rounded box."
        },
        {
          "value": true,
          "label": "Separators",
          "description": "No boxes; thin lines separate the groups."
        }
      ],
      "consumers": [
        "modules/ii/bar/BarContent.qml",
        "modules/ii/bar/BarGroup.qml",
        "modules/ii/bar/BatteryIndicator.qml",
        "modules/ii/bar/ClockWidget.qml"
      ]
    },
    {
      "key": "bar.showBackground",
      "section": "layout",
      "label": "Bar background",
      "description": "Draw a solid strip behind the modules; off leaves them floating over the wallpaper.",
      "keywords": [
        "Background",
        "Fondo"
      ],
      "icon": "rectangle",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/Bar.qml",
        "modules/ii/bar/BarContent.qml",
        "modules/ii/verticalBar/VerticalBar.qml",
        "modules/ii/verticalBar/VerticalBarContent.qml"
      ]
    },
    {
      "key": "bar.verbose",
      "section": "layout",
      "label": "Show song title and buttons",
      "description": "Show the playing song in the media module and the buttons next to the clock; the center gets wider.",
      "keywords": [
        "Detailed",
        "Detallada"
      ],
      "icon": "notes",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/common/Appearance.qml",
        "modules/ii/bar/BarContent.qml",
        "modules/ii/bar/Media.qml"
      ]
    },
    {
      "key": "bar.topLeftIcon",
      "section": "layout",
      "label": "Corner icon",
      "description": "Logo on the button that opens the left sidebar (Super+A).",
      "icon": "image",
      "backend": "config",
      "type": "enum",
      "widget": "select",
      "options": [
        {
          "value": "distro",
          "label": "Your distribution"
        },
        {
          "value": "linux",
          "label": "Linux"
        },
        {
          "value": "arch",
          "label": "Arch"
        },
        {
          "value": "cachyos",
          "label": "CachyOS"
        },
        {
          "value": "debian",
          "label": "Debian"
        },
        {
          "value": "endeavouros",
          "label": "EndeavourOS"
        },
        {
          "value": "fedora",
          "label": "Fedora"
        },
        {
          "value": "gentoo",
          "label": "Gentoo"
        },
        {
          "value": "nixos",
          "label": "NixOS"
        },
        {
          "value": "nyarch",
          "label": "Nyarch"
        },
        {
          "value": "ubuntu",
          "label": "Ubuntu"
        }
      ],
      "consumers": [
        "modules/ii/bar/LeftSidebarButton.qml"
      ]
    },
    {
      "key": "bar.screenList",
      "section": "layout",
      "label": "Screens",
      "description": "Screens that show the bar.",
      "keywords": [
        "monitor",
        "pantallas"
      ],
      "icon": "monitor",
      "backend": "config",
      "type": "custom",
      "widget": "custom",
      "keys": [
        "bar.screenList"
      ],
      "consumers": [
        "modules/ii/bar/Bar.qml",
        "modules/ii/verticalBar/VerticalBar.qml"
      ]
    },
    {
      "key": "bar.autoHide.enable",
      "section": "autoHide",
      "label": "Hide the bar",
      "description": "Show the bar only when the pointer reaches its edge.",
      "keywords": [
        "autohide",
        "ocultar"
      ],
      "icon": "visibility_off",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/Bar.qml",
        "modules/ii/verticalBar/VerticalBar.qml"
      ]
    },
    {
      "key": "bar.autoHide.hoverRegionWidth",
      "section": "autoHide",
      "label": "Bar reveal zone",
      "description": "Thickness of the screen edge that brings the bar back when the pointer touches it.",
      "keywords": [
        "Reveal zone",
        "Zona para mostrar"
      ],
      "icon": "border_outer",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 1,
      "max": 20,
      "unit": "px",
      "enabledWhen": {
        "key": "bar.autoHide.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/bar/Bar.qml",
        "modules/ii/verticalBar/VerticalBar.qml"
      ]
    },
    {
      "key": "bar.autoHide.pushWindows",
      "section": "autoHide",
      "label": "Push windows",
      "description": "While the bar shows, tiled windows make room for it instead of being covered.",
      "icon": "expand",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "bar.autoHide.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/bar/Bar.qml",
        "modules/ii/verticalBar/VerticalBar.qml"
      ]
    },
    {
      "key": "bar.autoHide.showWhenPressingSuper.enable",
      "section": "autoHide",
      "label": "Show while holding Super",
      "description": "Holding Super reveals the hidden bar and shows the workspace numbers.",
      "icon": "keyboard_command_key",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/Bar.qml",
        "modules/ii/bar/Workspaces.qml",
        "modules/ii/verticalBar/VerticalBar.qml"
      ]
    },
    {
      "key": "bar.autoHide.showWhenPressingSuper.delay",
      "section": "autoHide",
      "label": "Delay before showing",
      "description": "How long Super must be held first, so a quick press does not flash them.",
      "keywords": [
        "Delay",
        "Retraso",
        "retardo"
      ],
      "icon": "timer",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "ms",
      "enabledWhen": {
        "key": "bar.autoHide.showWhenPressingSuper.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/bar/Bar.qml",
        "modules/ii/bar/Workspaces.qml",
        "modules/ii/verticalBar/VerticalBar.qml"
      ]
    },
    {
      "key": "bar.workspaces.shown",
      "section": "workspaces",
      "label": "Workspaces per group",
      "description": "How many workspaces the indicator shows at once; higher ones appear as the next group.",
      "help": "It also sets how far the wallpaper slides per workspace.",
      "keywords": [
        "Workspaces shown",
        "Espacios de trabajo mostrados"
      ],
      "icon": "filter_9_plus",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 1,
      "max": 30,
      "consumers": [
        "modules/ii/background/Background.qml",
        "modules/ii/bar/Workspaces.qml"
      ]
    },
    {
      "key": "bar.workspaces.showAppIcons",
      "section": "workspaces",
      "label": "App icons",
      "description": "Show the icon of the main window of each workspace.",
      "icon": "apps",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/Workspaces.qml"
      ]
    },
    {
      "key": "bar.workspaces.monochromeIcons",
      "section": "workspaces",
      "label": "Monochrome app icons",
      "description": "Draw the app icons in one muted color instead of their own colors.",
      "keywords": [
        "Tint app icons",
        "Colorear iconos de aplicaciones"
      ],
      "icon": "format_color_fill",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "bar.workspaces.showAppIcons",
        "equals": true
      },
      "consumers": [
        "modules/ii/bar/Workspaces.qml"
      ]
    },
    {
      "key": "bar.workspaces.alwaysShowNumbers",
      "section": "workspaces",
      "label": "Always show numbers",
      "description": "Show the workspace number instead of a dot on workspaces without an app icon.",
      "icon": "pin",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/Workspaces.qml"
      ]
    },
    {
      "key": "bar.workspaces.numberMap",
      "section": "workspaces",
      "label": "Workspace labels",
      "description": "Text shown instead of each number, in order.",
      "help": "The first item replaces 1, the second 2, and so on; for example 一, 二, 三. Turn on “Nerd Font labels” to use icon glyphs.",
      "icon": "label",
      "backend": "config",
      "type": "list",
      "widget": "list",
      "placeholder": "一",
      "consumers": [
        "modules/ii/bar/Workspaces.qml"
      ]
    },
    {
      "key": "bar.workspaces.useNerdFont",
      "section": "workspaces",
      "label": "Nerd Font labels",
      "description": "Draw the labels with the Nerd Font, for icon glyphs.",
      "icon": "emoji_symbols",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/Workspaces.qml"
      ]
    },
    {
      "key": "bar.utilButtons.showKeyboardToggle",
      "section": "buttons",
      "label": "On-screen keyboard",
      "description": "Button that shows or hides the on-screen keyboard (also Super+K).",
      "icon": "keyboard",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/UtilButtons.qml"
      ]
    },
    {
      "key": "bar.utilButtons.showMicToggle",
      "section": "buttons",
      "label": "Microphone",
      "description": "Button that mutes or unmutes the default microphone.",
      "icon": "mic",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/UtilButtons.qml"
      ]
    },
    {
      "key": "bar.utilButtons.showDarkModeToggle",
      "section": "buttons",
      "label": "Light and dark mode",
      "description": "Button that switches between light and dark mode (also Ctrl+Super+Shift+D).",
      "icon": "contrast",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/UtilButtons.qml"
      ]
    },
    {
      "key": "bar.indicators.notifications.showUnreadCount",
      "section": "indicators",
      "label": "Unread count",
      "description": "Show how many notifications are unread.",
      "icon": "notifications_unread",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/NotificationUnreadCount.qml"
      ]
    },
    {
      "key": "bar.tooltips.clickToShow",
      "section": "indicators",
      "label": "Click for details",
      "description": "Open the details of the clock, battery, resources and weather on click instead of on hover.",
      "icon": "ads_click",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/BatteryIndicator.qml",
        "modules/ii/bar/ClockWidget.qml",
        "modules/ii/bar/Resources.qml",
        "modules/ii/bar/weather/WeatherBar.qml"
      ]
    },
    {
      "key": "bar.resources.alwaysShowGpu",
      "section": "resources",
      "label": "Always show the GPU",
      "description": "Add a GPU usage meter under memory, swap and CPU when a GPU is detected.",
      "icon": "developer_board",
      "backend": "config",
      "type": "bool",
      "visibleWhen": {
        "key": "bar.vertical",
        "equals": true
      },
      "consumers": [
        "modules/ii/verticalBar/Resources.qml"
      ]
    },
    {
      "key": "bar.resources.cpuWarningThreshold",
      "section": "resources",
      "label": "CPU warning",
      "description": "The CPU meter changes color at or above this usage.",
      "icon": "memory",
      "backend": "config",
      "type": "int",
      "widget": "slider",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "visibleWhen": {
        "key": "bar.vertical",
        "equals": true
      },
      "consumers": [
        "modules/ii/verticalBar/Resources.qml"
      ]
    },
    {
      "key": "bar.resources.gpuWarningThreshold",
      "section": "resources",
      "label": "GPU warning",
      "description": "The GPU meter changes color at or above this usage.",
      "icon": "developer_board",
      "backend": "config",
      "type": "int",
      "widget": "slider",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "visibleWhen": {
        "key": "bar.vertical",
        "equals": true
      },
      "consumers": [
        "modules/ii/verticalBar/Resources.qml"
      ]
    },
    {
      "key": "bar.resources.memoryWarningThreshold",
      "section": "resources",
      "label": "Memory warning",
      "description": "The memory meter changes color at or above this usage.",
      "icon": "memory_alt",
      "backend": "config",
      "type": "int",
      "widget": "slider",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "visibleWhen": {
        "key": "bar.vertical",
        "equals": true
      },
      "consumers": [
        "modules/ii/verticalBar/Resources.qml"
      ]
    },
    {
      "key": "bar.resources.swapWarningThreshold",
      "section": "resources",
      "label": "Swap warning",
      "description": "The swap meter changes color at or above this usage.",
      "icon": "swap_horiz",
      "backend": "config",
      "type": "int",
      "widget": "slider",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "visibleWhen": {
        "key": "bar.vertical",
        "equals": true
      },
      "consumers": [
        "modules/ii/verticalBar/Resources.qml"
      ]
    },
    {
      "key": "bar.weather.enable",
      "section": "weather",
      "label": "Weather in the bar",
      "description": "Show the current temperature and conditions on the right of the bar.",
      "icon": "partly_cloudy_day",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/BarContent.qml"
      ]
    },
    {
      "key": "tray.monochromeIcons",
      "section": "tray",
      "label": "Monochrome icons",
      "description": "Draw tray icons in one muted color instead of their own colors.",
      "keywords": [
        "Tint icons",
        "Colorear iconos"
      ],
      "icon": "format_color_fill",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/bar/SysTrayItem.qml"
      ]
    },
    {
      "key": "tray.invertPinnedItems",
      "section": "tray",
      "label": "Show every icon in the bar",
      "description": "Every tray icon shows in the bar except those in the list below, which go to the overflow menu.",
      "help": "Off: only the icons in the list show in the bar and the rest wait in the overflow menu.",
      "keywords": [
        "Pin by default",
        "Fijar por defecto"
      ],
      "icon": "push_pin",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "services/TrayService.qml"
      ]
    },
    {
      "key": "tray.pinnedItems",
      "section": "tray",
      "label": "Listed icons",
      "description": "IDs of the tray icons kept in the bar, or kept in the overflow menu while the switch above is on.",
      "help": "Right-click a tray icon and choose Pin or Unpin to edit this list; Advanced › Show tray item ids adds each ID to its tooltip.",
      "keywords": [
        "Pinned items",
        "Elementos fijados"
      ],
      "icon": "list",
      "backend": "config",
      "type": "list",
      "widget": "list",
      "placeholder": "Fcitx",
      "consumers": [
        "services/TrayService.qml"
      ]
    },
    {
      "key": "tray.filterPassive",
      "section": "tray",
      "label": "Hide idle items",
      "description": "Hide icons whose app marks them as having nothing to show right now.",
      "icon": "filter_alt",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "services/TrayService.qml"
      ]
    }
  ]
}
