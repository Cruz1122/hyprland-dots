{
  "id": "panels",
  "title": "Panels and overlays",
  "icon": "dock_to_right",
  "description": "The right sidebar, dock, overview, widget layer, on-screen keyboard and other shell panels.",
  "sections": [
    {
      "id": "rightSidebar",
      "title": "Right sidebar",
      "icon": "dock_to_left",
      "description": "The panel that opens on the right with Super+N: quick toggles, sliders, notifications and calendar."
    },
    {
      "id": "cornerOpen",
      "title": "Open from screen corners",
      "icon": "rounded_corner",
      "description": "Click a screen corner to open the sidebar on that side: left (Super+A) or right (Super+N)."
    },
    {
      "id": "dock",
      "title": "Dock",
      "icon": "call_to_action",
      "description": "A bar at the bottom of the screen with your pinned apps and open windows."
    },
    {
      "id": "overview",
      "title": "Overview",
      "icon": "overview_key",
      "description": "The search with a grid of your workspaces that opens with Super or Super+Tab."
    },
    {
      "id": "overlay",
      "title": "Widget layer",
      "icon": "layers",
      "description": "Widgets such as a crosshair, an image or notes that you open over everything with Super+G."
    },
    {
      "id": "osd",
      "title": "Volume and brightness indicator",
      "icon": "tune",
      "description": "The small indicator that shows the level when you change the volume or the brightness."
    },
    {
      "id": "osk",
      "title": "On-screen keyboard",
      "icon": "keyboard",
      "description": "A keyboard you use with the mouse or a touch screen; it opens with Super+K."
    },
    {
      "id": "cheatsheet",
      "title": "Shortcut guide",
      "icon": "keyboard_command_key",
      "description": "How the list of keyboard shortcuts that opens with Super+F1 looks."
    },
    {
      "id": "media",
      "title": "Media",
      "icon": "music_note",
      "description": "Music and video players shown in the bar and in the media controls."
    }
  ],
  "entries": [
    {
      "key": "sidebar.keepRightSidebarLoaded",
      "section": "rightSidebar",
      "label": "Keep loaded",
      "description": "The sidebar opens instantly, but it keeps using memory while it is closed.",
      "icon": "bolt",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/sidebarRight/SidebarRight.qml"
      ]
    },
    {
      "key": "sidebar.quickToggles.style",
      "section": "rightSidebar",
      "label": "Quick toggles",
      "description": "Look of the Wi-Fi, Bluetooth, night light and other quick buttons.",
      "icon": "toggle_on",
      "backend": "config",
      "type": "enum",
      "widget": "segmented",
      "options": [
        {
          "value": "android",
          "label": "Android",
          "description": "Large tiles in a grid; the pencil button lets you add, move and resize them."
        },
        {
          "value": "classic",
          "label": "Classic",
          "description": "One row of small icon buttons with a fixed set of toggles."
        }
      ],
      "consumers": [
        "modules/ii/sidebarRight/SidebarRightContent.qml"
      ]
    },
    {
      "key": "sidebar.quickToggles.android.columns",
      "section": "rightSidebar",
      "label": "Tile columns",
      "description": "How many tiles fit in each row; a wide tile takes two places.",
      "keywords": [
        "Columns",
        "Columnas"
      ],
      "icon": "view_column",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 1,
      "max": 8,
      "visibleWhen": {
        "key": "sidebar.quickToggles.style",
        "equals": "android"
      },
      "consumers": [
        "modules/ii/sidebarRight/quickToggles/AndroidQuickPanel.qml"
      ]
    },
    {
      "key": "sidebar.quickSliders.enable",
      "section": "rightSidebar",
      "label": "Quick sliders",
      "description": "Brightness, volume and microphone sliders above the quick toggles.",
      "icon": "tune",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/sidebarRight/SidebarRightContent.qml"
      ]
    },
    {
      "key": "sidebar.quickSliders.showBrightness",
      "section": "rightSidebar",
      "label": "Brightness slider",
      "description": "Brightness of the display that shows the sidebar.",
      "icon": "brightness_6",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "sidebar.quickSliders.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/sidebarRight/QuickSliders.qml"
      ]
    },
    {
      "key": "sidebar.quickSliders.showVolume",
      "section": "rightSidebar",
      "label": "Volume slider",
      "description": "Volume of the default output device.",
      "icon": "volume_up",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "sidebar.quickSliders.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/sidebarRight/QuickSliders.qml"
      ]
    },
    {
      "key": "sidebar.quickSliders.showMic",
      "section": "rightSidebar",
      "label": "Microphone slider",
      "description": "Input level of the default microphone.",
      "icon": "mic",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "sidebar.quickSliders.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/sidebarRight/QuickSliders.qml"
      ]
    },
    {
      "key": "sidebar.cornerOpen.enable",
      "section": "cornerOpen",
      "label": "Active corners",
      "description": "Clicking a top corner opens the sidebar on that side; it does not work over fullscreen windows.",
      "keywords": [
        "Open from corners",
        "Abrir desde las esquinas"
      ],
      "icon": "rounded_corner",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/screenCorners/ScreenCorners.qml"
      ]
    },
    {
      "key": "sidebar.cornerOpen.bottom",
      "section": "cornerOpen",
      "label": "Use the bottom corners",
      "description": "The bottom corners open the sidebars instead of the top ones.",
      "icon": "vertical_align_bottom",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "sidebar.cornerOpen.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/screenCorners/ScreenCorners.qml"
      ]
    },
    {
      "key": "sidebar.cornerOpen.clickless",
      "section": "cornerOpen",
      "label": "Open on hover",
      "description": "The sidebar opens as soon as the pointer enters the corner zone, without clicking.",
      "icon": "near_me",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "sidebar.cornerOpen.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/screenCorners/ScreenCorners.qml"
      ]
    },
    {
      "key": "sidebar.cornerOpen.clicklessCornerEnd",
      "section": "cornerOpen",
      "label": "Open at the screen edge",
      "description": "Pushing the pointer against the left or right screen edge inside the zone opens the sidebar.",
      "keywords": [
        "Hover the very corner",
        "Pasar por la esquina exacta"
      ],
      "icon": "north_west",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "all": [
          {
            "key": "sidebar.cornerOpen.enable",
            "equals": true
          },
          {
            "key": "sidebar.cornerOpen.clickless",
            "equals": false
          }
        ]
      },
      "consumers": [
        "modules/ii/screenCorners/ScreenCorners.qml"
      ]
    },
    {
      "key": "sidebar.cornerOpen.clicklessCornerVerticalOffset",
      "section": "cornerOpen",
      "label": "Ignored pixels next to the corner",
      "description": "The edge opens the sidebar only this far from the corner, so sliding along the top or bottom does not.",
      "keywords": [
        "Corner offset",
        "Desplazamiento de la esquina"
      ],
      "icon": "height",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 0,
      "max": 20,
      "unit": "px",
      "enabledWhen": {
        "all": [
          {
            "key": "sidebar.cornerOpen.enable",
            "equals": true
          },
          {
            "key": "sidebar.cornerOpen.clickless",
            "equals": false
          },
          {
            "key": "sidebar.cornerOpen.clicklessCornerEnd",
            "equals": true
          }
        ]
      },
      "consumers": [
        "modules/ii/screenCorners/ScreenCorners.qml"
      ]
    },
    {
      "key": "sidebar.cornerOpen.valueScroll",
      "section": "cornerOpen",
      "label": "Scroll to adjust",
      "description": "Scrolling on a left corner changes the brightness, and on a right corner the volume.",
      "icon": "swap_vert",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "sidebar.cornerOpen.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/screenCorners/ScreenCorners.qml"
      ]
    },
    {
      "key": "sidebar.cornerOpen.cornerRegionWidth",
      "section": "cornerOpen",
      "label": "Zone width",
      "description": "Width of the area at each corner that reacts to the pointer.",
      "icon": "width",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 1,
      "max": 300,
      "unit": "px",
      "enabledWhen": {
        "key": "sidebar.cornerOpen.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/screenCorners/ScreenCorners.qml"
      ]
    },
    {
      "key": "sidebar.cornerOpen.cornerRegionHeight",
      "section": "cornerOpen",
      "label": "Zone height",
      "description": "Height of the area at each corner that reacts to the pointer.",
      "icon": "height",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 1,
      "max": 300,
      "unit": "px",
      "enabledWhen": {
        "key": "sidebar.cornerOpen.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/screenCorners/ScreenCorners.qml"
      ]
    },
    {
      "key": "sidebar.cornerOpen.visualize",
      "section": "cornerOpen",
      "label": "Show the zones",
      "description": "Draw the corner zones to help adjust them.",
      "icon": "visibility",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "sidebar.cornerOpen.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/screenCorners/ScreenCorners.qml"
      ]
    },
    {
      "key": "dock.enable",
      "section": "dock",
      "label": "Show the dock",
      "description": "It hides while a window has the focus and comes back on an empty workspace.",
      "keywords": [
        "Dock"
      ],
      "icon": "call_to_action",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "panelFamilies/IllogicalImpulseFamily.qml"
      ]
    },
    {
      "key": "dock.hoverToReveal",
      "section": "dock",
      "label": "Reveal on hover",
      "description": "While the dock is hidden, moving the pointer to the bottom edge brings it back.",
      "icon": "near_me",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "dock.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/dock/Dock.qml"
      ]
    },
    {
      "key": "dock.pinnedOnStartup",
      "section": "dock",
      "label": "Pin the dock at startup",
      "description": "The dock starts always visible and windows leave room for it.",
      "help": "If you used the pin button on the dock, this setting applies the next time the shell starts.",
      "keywords": [
        "Pinned on startup",
        "Anclado al inicio"
      ],
      "icon": "push_pin",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "dock.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/dock/Dock.qml"
      ]
    },
    {
      "key": "dock.monochromeIcons",
      "section": "dock",
      "label": "Monochrome dock icons",
      "description": "App icons turn almost gray, with a light tint of the accent color.",
      "keywords": [
        "Tint app icons",
        "Colorear iconos de aplicaciones"
      ],
      "icon": "format_color_fill",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "dock.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/dock/DockAppButton.qml"
      ]
    },
    {
      "key": "dock.height",
      "section": "dock",
      "label": "Height",
      "description": "Height of the dock bar; the app icons keep their size.",
      "icon": "height",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 40,
      "max": 120,
      "step": 2,
      "decimals": 0,
      "unit": "px",
      "enabledWhen": {
        "key": "dock.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/dock/Dock.qml"
      ]
    },
    {
      "key": "dock.hoverRegionHeight",
      "section": "dock",
      "label": "Reveal strip height",
      "description": "Thickness of the strip at the bottom edge that brings the hidden dock back.",
      "keywords": [
        "Reveal zone",
        "Zona para mostrar"
      ],
      "icon": "border_bottom",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 1,
      "max": 20,
      "step": 1,
      "decimals": 0,
      "unit": "px",
      "enabledWhen": {
        "all": [
          {
            "key": "dock.enable",
            "equals": true
          },
          {
            "key": "dock.hoverToReveal",
            "equals": true
          }
        ]
      },
      "consumers": [
        "modules/ii/dock/Dock.qml"
      ]
    },
    {
      "key": "dock.pinnedApps",
      "section": "dock",
      "label": "Apps pinned to the dock",
      "description": "They are always shown first, by app ID: the name of the .desktop file without the extension.",
      "help": "You can also right-click an app in the dock to pin or unpin it without typing its ID.",
      "keywords": [
        "Pinned apps",
        "Aplicaciones ancladas"
      ],
      "icon": "keep",
      "backend": "config",
      "type": "list",
      "widget": "list",
      "placeholder": "org.kde.dolphin",
      "validate": {
        "regex": "^[A-Za-z0-9._-]+$"
      },
      "consumers": [
        "modules/waffle/startMenu/searchPage/SearchResults.qml",
        "services/TaskbarApps.qml"
      ]
    },
    {
      "key": "dock.ignoredAppRegexes",
      "section": "dock",
      "label": "Ignored apps",
      "description": "Windows whose app ID matches one of these patterns never appear in the dock.",
      "help": "Patterns are regular expressions and ignore upper and lower case. Example: ^steam_app_.*$ hides the windows of Steam games.",
      "icon": "block",
      "backend": "config",
      "type": "list",
      "widget": "list",
      "placeholder": "^steam_app_.*$",
      "consumers": [
        "services/TaskbarApps.qml"
      ]
    },
    {
      "key": "overview.enable",
      "section": "overview",
      "label": "Show the workspace grid",
      "description": "Workspace thumbnails under the search; when it is off, Super and Super+Tab open only the search.",
      "keywords": [
        "Overview",
        "Vista general"
      ],
      "icon": "overview_key",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/overview/Overview.qml"
      ]
    },
    {
      "key": "overview.scale",
      "section": "overview",
      "label": "Thumbnail size",
      "description": "Size of each workspace thumbnail, as a percentage of the screen.",
      "keywords": [
        "Size",
        "Tamaño"
      ],
      "icon": "zoom_in",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 0.05,
      "max": 0.5,
      "step": 0.01,
      "uiScale": 100,
      "decimals": 0,
      "unit": "%",
      "enabledWhen": {
        "key": "overview.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/overview/OverviewWidget.qml"
      ]
    },
    {
      "key": "overview.rows",
      "section": "overview",
      "label": "Rows",
      "description": "Rows of the grid; it shows rows × columns workspaces, the group that holds the current one.",
      "icon": "table_rows",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 1,
      "max": 20,
      "enabledWhen": {
        "key": "overview.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/overview/OverviewWidget.qml"
      ]
    },
    {
      "key": "overview.columns",
      "section": "overview",
      "label": "Grid columns",
      "description": "Workspaces in each row of the grid.",
      "keywords": [
        "Columns",
        "Columnas"
      ],
      "icon": "view_column",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 1,
      "max": 20,
      "enabledWhen": {
        "key": "overview.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/overview/OverviewWidget.qml"
      ]
    },
    {
      "key": "overview.orderRightLeft",
      "section": "overview",
      "label": "Horizontal order",
      "description": "Direction in which the workspace numbers grow along each row.",
      "icon": "swap_horiz",
      "backend": "config",
      "type": "enum",
      "widget": "segmented",
      "options": [
        {
          "value": false,
          "label": "Left to right"
        },
        {
          "value": true,
          "label": "Right to left"
        }
      ],
      "enabledWhen": {
        "key": "overview.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/overview/OverviewWidget.qml"
      ]
    },
    {
      "key": "overview.orderBottomUp",
      "section": "overview",
      "label": "Vertical order",
      "description": "Whether the first row of workspaces is at the top or at the bottom.",
      "icon": "swap_vert",
      "backend": "config",
      "type": "enum",
      "widget": "segmented",
      "options": [
        {
          "value": false,
          "label": "Top down"
        },
        {
          "value": true,
          "label": "Bottom up"
        }
      ],
      "enabledWhen": {
        "key": "overview.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/overview/OverviewWidget.qml"
      ]
    },
    {
      "key": "overview.centerIcons",
      "section": "overview",
      "label": "Center icons",
      "description": "A large app icon in the middle of each window thumbnail instead of a small one in its corner.",
      "icon": "center_focus_strong",
      "backend": "config",
      "type": "bool",
      "enabledWhen": {
        "key": "overview.enable",
        "equals": true
      },
      "consumers": [
        "modules/ii/overview/OverviewWindow.qml"
      ]
    },
    {
      "key": "overlay.openingZoomAnimation",
      "section": "overlay",
      "label": "Zoom when opening",
      "description": "The widgets start slightly larger and shrink into place when the layer opens.",
      "keywords": [
        "overlay",
        "superposición"
      ],
      "icon": "zoom_out_map",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/overlay/OverlayContent.qml"
      ]
    },
    {
      "key": "overlay.darkenScreen",
      "section": "overlay",
      "label": "Darken the screen",
      "description": "Dims everything behind the widgets while the layer is open.",
      "keywords": [
        "overlay",
        "superposición"
      ],
      "icon": "brightness_4",
      "backend": "config",
      "type": "bool",
      "consumers": [
        "modules/ii/overlay/OverlayContent.qml"
      ]
    },
    {
      "key": "overlay.clickthroughOpacity",
      "section": "overlay",
      "label": "Pinned widget opacity",
      "description": "Opacity of pinned widgets that let clicks pass through, while the layer is closed.",
      "help": "Pinned widgets that stay clickable are always fully opaque.",
      "keywords": [
        "overlay",
        "superposición",
        "Opacidad de widgets fijados"
      ],
      "icon": "opacity",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "uiScale": 100,
      "decimals": 0,
      "unit": "%",
      "consumers": [
        "modules/ii/overlay/StyledOverlayWidget.qml"
      ]
    },
    {
      "key": "overlay.floatingImage.imageSource",
      "section": "overlay",
      "label": "Floating image",
      "description": "Image or GIF shown by the floating image widget: a web address or a file:// path.",
      "icon": "image",
      "backend": "config",
      "type": "url",
      "widget": "text",
      "validate": {
        "regex": "^(https?|file)://\\S+$"
      },
      "placeholder": "https://…",
      "consumers": [
        "modules/ii/overlay/floatingImage/FloatingImage.qml"
      ]
    },
    {
      "key": "overlay.floatingImage.scale",
      "section": "overlay",
      "label": "Image scale",
      "description": "Size of the floating image compared with its original size.",
      "help": "You can also scroll on the image to resize it.",
      "icon": "photo_size_select_large",
      "backend": "config",
      "type": "real",
      "widget": "slider",
      "min": 0.1,
      "max": 2,
      "step": 0.05,
      "uiScale": 100,
      "decimals": 0,
      "unit": "%",
      "consumers": [
        "modules/ii/overlay/floatingImage/FloatingImage.qml"
      ]
    },
    {
      "key": "crosshair.code",
      "section": "overlay",
      "label": "Crosshair code",
      "description": "Valorant crosshair code drawn by the crosshair widget of the layer.",
      "help": "Paste a code made in Valorant or in a crosshair builder such as vcrdb.net.",
      "keywords": [
        "crosshair",
        "mira",
        "valorant"
      ],
      "icon": "point_scan",
      "backend": "config",
      "type": "string",
      "widget": "text",
      "validate": {
        "nonEmpty": true
      },
      "consumers": [
        "modules/ii/overlay/crosshair/CrosshairContent.qml"
      ]
    },
    {
      "key": "osd.timeout",
      "section": "osd",
      "label": "Time on screen",
      "description": "How long the indicator stays after the last volume or brightness change.",
      "keywords": [
        "Duration",
        "Duración",
        "osd"
      ],
      "icon": "timer",
      "backend": "config",
      "type": "int",
      "widget": "spin",
      "min": 100,
      "max": 3000,
      "step": 100,
      "unit": "ms",
      "consumers": [
        "modules/ii/onScreenDisplay/OnScreenDisplay.qml",
        "modules/waffle/onScreenDisplay/OSDValue.qml"
      ]
    },
    {
      "key": "osk.layout",
      "section": "osk",
      "label": "Keyboard layout",
      "description": "Which keys the on-screen keyboard shows.",
      "icon": "keyboard",
      "backend": "config",
      "type": "enum",
      "widget": "select",
      "options": [
        {
          "value": "qwerty_full",
          "label": "Default",
          "description": "The same keys as English (US)."
        },
        {
          "value": "English (US)",
          "label": "English (US)"
        },
        {
          "value": "German",
          "label": "German"
        },
        {
          "value": "Russian",
          "label": "Russian"
        }
      ],
