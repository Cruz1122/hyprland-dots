import QtQuick
import QtTest
import "../../config/quickshell/ii/modules/settings/components/CurveMath.js" as CM

// CurveMath.js against tests/fixtures/curve-golden.json (generated by
// tests/curve_reference.py). Reading a local file needs
// QML_XHR_ALLOW_FILE_READ=1: tests/test_curve_math.py sets it and requires
// these tests to run; other runners without it skip the golden checks.
TestCase {
    name: "CurveMath"

    readonly property real tolerance: 1e-6
    property var golden: null

    function initTestCase() {
        const xhr = new XMLHttpRequest();
        xhr.open("GET", Qt.resolvedUrl("../fixtures/curve-golden.json"), false);
        xhr.send();
        try {
            golden = JSON.parse(xhr.responseText);
        } catch (e) {
            golden = null;
        }
    }

    function requireGolden() {
        if (!golden)
            skip("curve-golden.json is not readable (set QML_XHR_ALLOW_FILE_READ=1)");
    }

    function near(actual, expected, what) {
        verify(Math.abs(actual - expected) <= tolerance, `${what}: ${actual} != ${expected}`);
    }

    function test_bezier_values_match_the_reference() {
        requireGolden();
        const names = Object.keys(golden.beziers);
        for (const required of ["default", "linear", "expressiveFastSpatial", "expressiveSlowSpatial",
                "expressiveDefaultSpatial", "emphasizedDecel", "emphasizedAccel", "standardDecel",
                "menu_decel", "menu_accel", "stall", "edge_overshoot", "edge_steep_start", "edge_steep_end"])
            verify(names.includes(required), required);
        for (const name of names) {
            const curve = golden.beziers[name];
            for (const pair of curve.values)
                near(CM.bezierY(curve.points, pair[0]), pair[1], `${name}(${pair[0]})`);
        }
    }

    function test_bezier_samples_match_the_reference() {
        requireGolden();
        for (const name of Object.keys(golden.beziers)) {
            const curve = golden.beziers[name];
            const samples = CM.sample({ type: "bezier", points: curve.points }, curve.sample.length);
            compare(samples.length, curve.sample.length);
            for (let i = 0; i < samples.length; i++) {
                near(samples[i].x, curve.sample[i][0], `${name} sample x ${i}`);
                near(samples[i].y, curve.sample[i][1], `${name} sample y ${i}`);
            }
        }
    }

    function test_spring_values_match_the_reference() {
        requireGolden();
        verify(golden.springs.ii_spring_soft !== undefined);
        verify(golden.springs.ii_spring_bouncy !== undefined);
        for (const name of Object.keys(golden.springs)) {
            const spring = golden.springs[name];
            compare(CM.springSettleMs(spring), spring.settleMs, `${name} settle`);
            for (const pair of spring.values)
                near(CM.springProgress(spring, pair[0]), pair[1], `${name}(${pair[0]} ms)`);
            const samples = CM.sample(Object.assign({ type: "spring" }, spring), spring.sample.length);
            for (let i = 0; i < samples.length; i++)
                near(samples[i].y, spring.sample[i][1], `${name} sample ${i}`);
        }
    }

    function test_baked_points_follow_hyprutils() {
        const baked = CM.bake([0, 0.75, 0.15, 1]);
        compare(baked.xs.length, 255);
        // t starts at 1/255, so the first baked point is not the origin.
        verify(baked.xs[0] > 0);
        near(baked.xs[254], 1, "last baked x");
        near(baked.ys[254], 1, "last baked y");
    }

    function test_edges() {
        compare(CM.bezierY([0.5, -1, 0.5, 2], 0), 0);
        compare(CM.bezierY([0.5, -1, 0.5, 2], -3), 0);
        compare(CM.bezierY([0.5, -1, 0.5, 2], 1), 1);
        compare(CM.bezierY([0.5, -1, 0.5, 2], 1.2), 1);
        verify(CM.bezierY([0.42, 1.67, 0.21, 0.9], 0.4) > 1, "expressiveFastSpatial overshoots");
        compare(CM.springProgress({ mass: 1, stiffness: 260, damping: 18 }, 0), 0);
        compare(CM.springProgress({ mass: 1, stiffness: 260, damping: 18 }, 5000), 1);
    }

    function test_speed_conversion() {
        compare(CM.speedToMs(3), 300);
        compare(CM.speedToMs(0.5), 50);
        compare(CM.msToSpeed(300), 3);
        compare(CM.msToSpeed(2000), 20);
        compare(CM.msToSpeed(333.4), 3.33);
        const spring = { type: "spring", mass: 1, stiffness: 260, damping: 18 };
        compare(CM.durationMs(spring, 3), CM.springSettleMs(spring));
        compare(CM.durationMs({ type: "bezier", points: [0, 0, 1, 1] }, 4.5), 450);
    }

    function test_clamp_point() {
        compare(CM.clampPoint([-0.2, -3, 1.5, 2.5]), [0, -1, 1, 2]);
        compare(CM.clampPoint([0.3, 1.67, 0.21, -0.5]), [0.3, 1.67, 0.21, -0.5]);
        compare(CM.clampPoint(["x", NaN, 0.5, 1]), [0, -1, 0.5, 1]);
    }

    function test_value_at_maps_linear_progress() {
        const bezier = { type: "bezier", points: [0.05, 0.7, 0.1, 1] };
        compare(CM.valueAt(bezier, 0.3, 300), CM.bezierY(bezier.points, 0.3));
        const spring = { type: "spring", mass: 1, stiffness: 238.1191, damping: 24.21279333 };
        const settle = CM.springSettleMs(spring);
        compare(CM.valueAt(spring, 0.25, settle), CM.springProgress(spring, settle * 0.25));
        compare(CM.valueAt(spring, 1, settle), 1);
    }
}
