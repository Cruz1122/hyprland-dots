//@ pragma UseQApplication
//@ pragma Env QS_NO_RELOAD_POPUP=1
//@ pragma Env QT_QUICK_CONTROLS_STYLE=Basic
//@ pragma Env QT_SCALE_FACTOR=1

// Harness driver (run.sh --hyprland-stub --allow-config-writes --driver):
// the Windows page's preview (SettingsWindowPreview) follows the page's
// values, highlights the focused row's part, and Game Mode pauses the rows it
// overrides. tests/test_window_preview.py reads the reports and checks the
// pixels of the saved magnifier images (SHOT_DIR).
//
// Steps: wait for the Hyprland backend; open the Windows page; check that
// there are 2 previews and only the first has the magnifier; write gaps,
// border, rounding and rounding power through SettingsStore and check the
// preview's geometry; focus the border row and check the highlight; move
// the pointer over previewed rows and check that the highlight follows; turn
// Game Mode on through its override file and check that the overridden rows
// keep the stored value and say "Paused by Game Mode"; turn it off and reset.
import QtQuick
import Quickshell
import Quickshell.Io
import QtTest
import qs.modules.common
// @harness-imports

ShellRoot {
    id: root

    readonly property string outDir: Quickshell.env("SHOT_DIR") || ""
    readonly property string header: "-- DO NOT EDIT THIS FILE. IT IS MANAGED BY THE SHELL\n"
    // GameModeToggle.overrides, as hyprconfigurator.py writes them.
    readonly property string gameModeText: root.header + [
        "hl.config({animations={enabled=0}})",
        "hl.config({decoration={shadow={enabled=0}}})",
        "hl.config({decoration={blur={enabled=0}}})",
        "hl.config({general={gaps_in=0}})",
        "hl.config({general={gaps_out=0}})",
        "hl.config({general={border_size=1}})",
        "hl.config({decoration={rounding=0}})",
        "hl.config({general={allow_tearing=1}})"
    ].join("\n") + "\n"
    readonly property var writes: [
        ["hyprland.general.gaps_in", 12],
        ["hyprland.general.gaps_out", 24],
        ["hyprland.general.border_size", 3],
        ["hyprland.decoration.rounding", 10],
        ["hyprland.decoration.rounding_power", 4]
    ]
    readonly property var pausedKeys: ["hyprland.general.gaps_in", "hyprland.general.gaps_out", "hyprland.general.border_size",
        "hyprland.decoration.rounding", "hyprland.decoration.blur.enabled", "hyprland.decoration.shadow.enabled",
        "hyprland.general.allow_tearing"]

    property var win: null
    property var page: null
    property var previews: []
    property var stored: ({})
    property int failures: 0

    function report(payload) {
        console.info(`[harness:report] ${JSON.stringify(payload)}`);
    }

    function check(name, ok, detail) {
        root.report(Object.assign({ type: "check", name: name, ok: !!ok }, detail ?? {}));
        if (!ok)
            root.failures++;
        return !!ok;
    }

    function finish() {
        root.report({ type: "done", failures: root.failures });
        quitTimer.start();
    }

    function fatal(message) {
        root.report({ type: "fatal", message: message });
        root.finish();
    }

    function walk(item, visit) {
        if (!item)
            return;
        visit(item);
        for (const child of item.children)
            root.walk(child, visit);
    }

    function find(item, name) {
        let found = null;
        root.walk(item, i => {
            if (!found && i.objectName === name)
                found = i;
        });
        return found;
    }

    function pageItem(id) {
        let found = null;
        root.walk(root.win.contentItem, item => {
            if (!found && item.pageId === id && item.contentY !== undefined)
                found = item;
        });
        return found;
    }

    function hypr() {
        return SettingsStore.backends?.hyprland ?? null;
    }

    function waitFor(test, timeoutMs, done) {
        pollComponent.createObject(root, { deadline: Date.now() + timeoutMs, test: test, done: done }).start();
    }

    function later(ms, action) {
        laterComponent.createObject(root, { interval: ms, action: action }).start();
    }

    function near(a, b) {
        return Math.abs(Number(a) - Number(b)) < 0.01;
    }

    // Saves the item at 1:1 for the Python test (pixel checks) and for a look.
    function save(item, name, done) {
        if (root.outDir.length === 0 || !item)
            return done();
        const file = `${root.outDir}/${name}.png`;
        item.grabToImage(result => {
            result.saveToFile(file);
            root.report({ type: "image", name: name, file: file, width: item.width, height: item.height });
            done();
        });
    }

    Component.onCompleted: {
        const component = Qt.createComponent(Qt.resolvedUrl("settings.qml"));
        if (component.status !== Component.Ready)
            return root.fatal(`settings.qml failed to load: ${component.errorString()}`);
        root.win = component.createObject(root, { width: 1100, height: 760 });
        root.waitFor(() => root.win.pageReady && root.hypr()?.available && root.hypr()?.baseLoaded && !root.hypr()?.busy, 30000, ok => {
            if (!ok)
                return root.fatal(`Hyprland backend never ready: ${root.hypr()?.unavailableReason ?? "no backend"}`);
            root.win.openPage("windows");
            root.waitFor(() => root.win.pageReady && root.pageItem("windows") !== null, 10000, ready => {
                if (!ready)
                    return root.fatal("the Windows page never opened");
                root.page = root.pageItem("windows");
                root.later(600, root.initial);
            });
        });
    }

    function initial() {
        const all = [];
        root.walk(root.page, item => {
            if (item.objectName === "windowPreview" || item.objectName === "windowEffectsPreview")
                all.push(item);
        });
        root.previews = all;
        root.check("two previews on the page", all.length === 2, { count: all.length });
        if (all.length !== 2)
            return root.finish();
        const [layout, effects] = all;
        root.check("only the first preview has the magnifier", layout.showMagnifier && !effects.showMagnifier, {});
        root.check("the preview fits the page", layout.width <= root.page.width && effects.width <= root.page.width,
            { layout: layout.width, effects: effects.width, page: root.page.width });
        const v = layout.model.values;
        root.check("the preview reads the current values", v.known
            && v.gapsIn === SettingsStore.value("hyprland.general.gaps_in")
            && v.gapsOut === SettingsStore.value("hyprland.general.gaps_out")
            && v.border === SettingsStore.value("hyprland.general.border_size")
            && v.rounding === SettingsStore.value("hyprland.decoration.rounding"), { values: v });
        for (const [key] of root.writes)
            root.stored[key] = SettingsStore.value(key);
        root.save(root.find(layout, "windowPreviewMagnifier"), "magnifier-before", root.writeValues);
    }

    function writeValues() {
        for (const [key, value] of root.writes)
            root.check(`${key}: write accepted`, SettingsStore.write(key, value), { key: key, value: value });
        const layout = root.previews[0];
        root.waitFor(() => layout.model.values.gapsIn === 12 && layout.model.values.roundingPower === 4, 5000, ok => {
            root.check("the preview follows the written values", ok, { values: layout.model.values });
            const m = layout.model;
            const s = m.scale;
            const main = m.tiled[0], right = m.tiled[1];
            root.check("desktop: edge gap is gaps_out", root.near(main.box.x, 24 * s), { x: main.box.x, scale: s });
            root.check("desktop: neighbors are 2 × gaps_in apart", root.near(right.box.x - (main.box.x + main.box.width), 24 * s),
                { gap: right.box.x - (main.box.x + main.box.width), scale: s });
            const l = layout.lens;
            root.check("magnifier: real-size border, rounding and gaps", l.main.border === 3 && l.rounding.size === 10
                && l.neighbor.box.x === layout.anchorX + 24 && l.bar.y + l.bar.height === layout.anchorY - 24,
                { border: l.main.border, rounding: l.rounding.size, neighborX: l.neighbor.box.x, barBottom: l.bar.y + l.bar.height });
            const labels = ["gapsOut", "gapsIn", "border", "rounding"].map(p => root.find(layout, "magnifierLabel:" + p)?.text ?? "");
            root.check("magnifier labels show the values", labels[0].indexOf("24") >= 0 && labels[1].indexOf("12") >= 0
                && labels[2].indexOf("3") >= 0 && labels[3].indexOf("10") >= 0, { labels: labels });
            root.report({ type: "lens", anchorX: layout.anchorX, anchorY: layout.anchorY, gapsIn: 12, gapsOut: 24, border: 3,
                activeBorder: String(layout.activeBorder), inactiveBorder: String(layout.inactiveBorder), wallpaper: String(layout.wallpaperColor) });
            root.later(300, () => root.save(root.find(layout, "windowPreviewMagnifier"), "magnifier-after",
                () => root.save(layout, "preview-after", root.highlight)));
        });
    }

    function highlight() {
        const layout = root.previews[0];
        const row = root.find(root.page, "row:hyprland.general.border_size");
        if (!root.check("border row found", row !== null, {}))
            return root.gameModeOn();
        row.forceActiveFocus();
        root.waitFor(() => layout.highlightPart === "border", 3000, ok => {
            root.check("focusing the border row highlights the border", ok,
                { focusedKey: root.page.focusedKey, part: layout.highlightPart });
            const label = root.find(layout, "magnifierLabel:border");
            root.check("the border label is emphasized", label?.on === true && label?.font.weight === Font.DemiBold, {});
            root.check("the effects preview highlights the same part", root.previews[1].highlightPart === "border", {});
            root.hover();
        });
    }

    // Real pointer moves (QtTest events) over previewed rows: the page's
    // hover handlers, not a direct property write, must move the highlight.
    function hover() {
        const layout = root.previews[0];
        const gapsRow = root.find(root.page, "row:hyprland.general.gaps_in");
        const borderRow = root.find(root.page, "row:hyprland.general.border_size");
        if (!root.check("gaps and border rows found", gapsRow !== null && borderRow !== null, {}))
            return root.gameModeOn();
        root.page.contentY = Math.max(0, gapsRow.mapToItem(root.page.contentItem, 0, 0).y - 40);
        root.later(300, () => {
            events.mouseMove(gapsRow, gapsRow.width / 2, gapsRow.height / 2, -1, Qt.NoButton, Qt.NoModifier);
            root.waitFor(() => layout.highlightPart === "gapsIn", 3000, entered => {
                root.check("a hovered row wins over the focused one", entered,
                    { hoveredKey: root.page.hoveredKey, part: layout.highlightPart });
                events.mouseMove(borderRow, borderRow.width / 2, borderRow.height / 2, -1, Qt.NoButton, Qt.NoModifier);
                root.waitFor(() => root.page.hoveredKey === "hyprland.general.border_size", 3000, moved => {
                    root.check("moving to another previewed row follows it", moved, { hoveredKey: root.page.hoveredKey });
                    events.mouseMove(root.win.contentItem, 2, 2, -1, Qt.NoButton, Qt.NoModifier);
                    root.waitFor(() => root.page.hoveredKey === "" && layout.highlightPart === "border", 3000, left => {
                        root.check("leaving the rows falls back to the focused one", left,
                            { hoveredKey: root.page.hoveredKey, part: layout.highlightPart });
                        root.later(300, () => root.save(root.find(layout, "windowPreviewMagnifier"), "magnifier-border", root.gameModeOn));
                    });
                });
            });
        });
    }

    function gameModeOn() {
        writer.setText(root.gameModeText);
        root.later(200, () => root.hypr().gameModeFile.reload());
        root.waitFor(() => SettingsStore.hasCapability("gameMode")
            && Object.keys(root.hypr().gameModeOverrides ?? {}).length >= 8 && !root.hypr().busy, 10000, ok => {
            root.check("Game Mode detected", ok, { overrides: root.hypr().gameModeOverrides ?? null });
            const banner = root.find(root.page, "row:info.windows.gameMode");
            root.check("Game Mode banner shown", banner !== null && banner.visible && banner.parent?.visible !== false, {});
            root.check("the banner says borders get thin and tearing is allowed",
                /1 px/.test(banner?.listedEntry?.description ?? "") && /tearing/.test(banner?.listedEntry?.description ?? ""),
                { description: banner?.listedEntry?.description ?? "" });
            const written = {};
            for (const [key, value] of root.writes)
                written[key] = value;
            for (const key of root.pausedKeys) {
                const expected = written[key] !== undefined ? written[key] : root.hypr().defaultValue(SettingsStore.entry(key));
                root.check(`${key}: paused by Game Mode`, SettingsStore.statusNote(key) === "Paused by Game Mode",
                    { key: key, note: SettingsStore.statusNote(key) });
                root.check(`${key}: shows the stored value`, JSON.stringify(SettingsStore.value(key)) === JSON.stringify(expected),
                    { key: key, value: SettingsStore.value(key) ?? null, expected: expected ?? null });
            }
            const note = root.find(root.find(root.page, "row:hyprland.general.gaps_in"), "statusNote");
            root.check("the row shows the pause note", note !== null && note.visible && String(note.text).length > 0,
                { text: note ? String(note.text) : "" });
            root.check("the preview keeps the stored values", root.previews[0].model.values.gapsIn === 12, {});
            root.check("rows not overridden are not paused", SettingsStore.statusNote("hyprland.decoration.rounding_power") === "", {});
            root.page.contentY = 0;
            root.later(400, () => root.save(root.page, "page-game-mode", root.gameModeOff));
        });
    }

    function gameModeOff() {
        writer.setText(root.header);
        root.later(200, () => root.hypr().gameModeFile.reload());
        root.waitFor(() => !SettingsStore.hasCapability("gameMode") && !root.hypr().busy, 10000, ok => {
            root.check("Game Mode off", ok, {});
            root.check("no row paused after Game Mode", root.pausedKeys.every(k => SettingsStore.statusNote(k) === ""), {});
            root.resetValues();
        });
    }

    function resetValues() {
        for (const [key] of root.writes)
            root.check(`${key}: reset accepted`, SettingsStore.reset(key), { key: key });
        root.waitFor(() => !root.hypr().busy, 10000, () => {
            root.hypr().hyprlandEvents.onRawEvent({ name: "configreloaded" });
            root.waitFor(() => !root.hypr().busy && root.writes.every(([key]) => !SettingsStore.isModified(key)), 10000, ok => {
                root.check("values back to their defaults", ok, {});
                root.check("the preview follows the reset",
                    root.previews[0].model.values.gapsIn === root.stored["hyprland.general.gaps_in"],
                    { gapsIn: root.previews[0].model.values.gapsIn, before: root.stored["hyprland.general.gaps_in"] });
                root.finish();
            });
        });
    }

    TestEvent {
        id: events
    }

    FileView {
        id: writer
        path: root.hypr()?.shellOverridesFile ?? ""
        printErrors: false
    }

    Process {
        running: (root.hypr()?.shellOverridesFile ?? "").length > 0
        command: ["mkdir", "-p", (root.hypr()?.shellOverridesFile ?? "/x/y").replace(/\/[^/]*$/, "")]
    }

    Timer {
        id: quitTimer
        interval: 200
        onTriggered: Qt.quit()
    }

    Component {
        id: laterComponent
        Timer {
            id: later
            property var action: null
            onTriggered: {
                const action = later.action;
                later.destroy();
                action();
            }
        }
    }

    Component {
        id: pollComponent
        Timer {
            id: poll
            property real deadline: 0
            property var test: null
            property var done: null
            interval: 100
            repeat: true
            onTriggered: {
                let ok = false;
                try {
                    ok = !!poll.test();
                } catch (error) {
                    ok = false;
                }
                if (ok || Date.now() > poll.deadline) {
                    poll.stop();
                    const done = poll.done;
                    poll.destroy();
                    done(ok);
                }
            }
        }
    }
}
