//@ pragma UseQApplication
//@ pragma Env QS_NO_RELOAD_POPUP=1

// Harness driver (run.sh --driver): Game Mode's toggle state must follow its
// own override in shellOverrides/main.lua, not the effective
// animations:enabled, which the settings app may also turn off.
import QtQuick
import Quickshell
import Quickshell.Io
import qs.modules.common.models.quickToggles
import qs.services

ShellRoot {
    id: root

    readonly property string header: "-- DO NOT EDIT THIS FILE. IT IS MANAGED BY THE SHELL\n"
    // The first step starts without the file (the watch cannot see it being
    // created); the reload Hyprland emits after Game Mode writes must refresh.
    readonly property var steps: [
        { name: "missing file", text: null, expected: false },
        { name: "created then reloaded", text: root.header + "hl.config({animations={enabled=0}})\n", reload: true, expected: true },
        { name: "header only", text: root.header, expected: false },
        { name: "other override", text: root.header + "hl.config({decoration={screen_shader=\"x\"}})\n", expected: false },
        { name: "game mode on", text: root.header + "hl.config({animations={enabled=0}})\nhl.config({general={gaps_in=0}})\n", expected: true },
        { name: "game mode off", text: root.header, expected: false }
    ]
    property int index: -1

    function report(payload) {
        console.info(`[harness:report] ${JSON.stringify(payload)}`);
    }

    function next() {
        root.index++;
        if (root.index >= root.steps.length) {
            root.report({ type: "done" });
            quitTimer.start();
            return;
        }
        const step = root.steps[root.index];
        if (step.text !== null)
            writer.setText(step.text);
        if (step.reload)
            reloadTimer.restart();
        checkTimer.waited = 0;
        checkTimer.restart();
    }

    GameModeToggle {
        id: toggle
    }

    FileView {
        id: writer
        path: HyprlandConfig.shellOverridesPath
    }

    Process {
        id: mkdir
        running: true
        command: ["mkdir", "-p", HyprlandConfig.shellOverridesPath.replace(/\/[^/]*$/, "")]
        onExited: root.next()
    }

    Timer {
        id: reloadTimer
        interval: 200
        onTriggered: HyprlandConfig.reloaded()
    }

    // Polls instead of sleeping a fixed time: under load the file watch and
    // the reload can take well over a second.
    Timer {
        id: checkTimer
        property int waited: 0
        interval: 100
        repeat: true
        onTriggered: {
            const step = root.steps[root.index];
            waited += interval;
            // Wait a moment even when the value already matches, so a late
            // wrong update would still be caught by the next step's check.
            if ((toggle.toggled !== step.expected || waited < 300) && waited < 5000)
                return;
            stop();
            waited = 0;
            root.report({ type: "gamemode", step: step.name, expected: step.expected, actual: toggle.toggled });
            root.next();
        }
    }

    Timer {
        id: quitTimer
        interval: 200
        onTriggered: Qt.quit()
    }
}
